{"products":[{"id":9261309100269,"title":"Mate de Acero Inoxidable","handle":"mate-de-acero-inoxidable","body_html":"\u003cp\u003eEl mate de acero inoxidable es una versión moderna de un clásico infaltable. Fabricado con materiales duraderos y de alta calidad, conserva mejor la temperatura de la infusión y evita la absorción de sabores, permitiendo disfrutar cada cebada con el sabor puro de la yerba.\u003c\/p\u003e\n\u003cp\u003eSu diseño ergonómico brinda un agarre cómodo, mientras que su interior de acero inoxidable lo hace higiénico, resistente y perfecto para el uso diario. Ideal tanto para quienes toman mate en casa como para llevarlo a la oficina o de viaje.\u003c\/p\u003e","published_at":"2026-02-01T18:47:22-05:00","created_at":"2026-02-01T18:02:07-05:00","updated_at":"2026-09-18T10:04:23-05:00","vendor":"Kaffee Platz","product_type":"","tags":[],"variants":[{"id":49330408947949,"title":"NEGRO","option1":"NEGRO","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":false,"featured_image":{"id":46273187512557,"product_id":9261309100269,"position":1,"created_at":"2026-02-01T18:02:24-05:00","updated_at":"2026-02-01T18:02:26-05:00","alt":null,"width":767,"height":767,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0740\/1088\/6381\/files\/rn-image_picker_lib_temp_1f032329-b8b4-428d-9202-d9ed0f38f8fa.png?v=1769986946","variant_ids":[49330408947949]},"available":false,"price":"108000.00","grams":0,"compare_at_price":"120000.00","position":1,"product_id":9261309100269,"created_at":"2026-02-01T18:19:18-05:00","updated_at":"2026-09-18T10:04:23-05:00"}],"images":[{"id":46273187512557,"created_at":"2026-02-01T18:02:24-05:00","position":1,"updated_at":"2026-02-01T18:02:26-05:00","product_id":9261309100269,"variant_ids":[49330408947949],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0740\/1088\/6381\/files\/rn-image_picker_lib_temp_1f032329-b8b4-428d-9202-d9ed0f38f8fa.png?v=1769986946","width":767,"height":767}],"options":[{"name":"COLOR","position":1