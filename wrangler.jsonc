{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaffeeplatz",
  "compatibility_date": "2026-09-30",
  // `nodejs_compat` lo necesita el Worker que genera @astrojs/cloudflare para
  // el renderizador de Astro. Sin esto el Worker no arranca.
  "compatibility_flags": ["nodejs_compat"],

  // PRODUCCION. Misma forma que wrangler.dev.jsonc, que es donde todo esto se
  // probo antes (oct-nov 2026). Lo unico distinto es el nombre, las rutas al
  // dominio, la base y el bucket.
  //
  // El envoltorio que añade `scheduled()` (el cron de reservas, G.2) al Worker
  // que genera Astro. Reexporta su `fetch` intacto: el sitio se sirve igual.
  // Requiere `npm run build` antes: importa `dist/_worker.js/index.js`.
  "main": "./src/worker/entrada.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // El Worker del adaptador NO delega en ASSETS por su cuenta: esta pensado
    // para Cloudflare Pages. En Workers hay que decir que el asset gana cuando
    // existe, o las paginas prerenderizadas dan 404 aunque esten subidas.
    "not_found_handling": "none",
    "run_worker_first": false
  },
  // Dirección de respaldo: https://kaffeeplatz.16ballcreations.workers.dev
  "workers_dev": true,
  // Dominio propio. El canonical de cada pagina apunta al dominio sin www
  // (SITE_URL), asi que en buscadores no compiten.
  "routes": [
    { "pattern": "kaffeeplatz.co", "custom_domain": true },
    { "pattern": "www.kaffeeplatz.co", "custom_domain": true }
  ],

  // Base de produccion, creada el 2 nov 2026 en ENAM (la misma region que la
  // de pruebas; desde Colombia se sirve por Miami). Arranco como copia de la
  // base de pruebas, que es donde la duena preparo el catalogo.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaffeeplatz",
      "database_id": "8c106766-b69e-4f97-8c93-85dbe6cdcedc",
      "migrations_dir": "migrations"
    }
  ],

  // Cada 5 minutos: caduca las reservas vencidas y, una vez al dia, el cuadre.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Fotos subidas desde el panel. Bucket de produccion, aparte del de pruebas.
  "r2_buckets": [
    { "binding": "MEDIOS", "bucket_name": "kaffeeplatz-medios" }
  ],

  "observability": {
    "enabled": true
  }
}
