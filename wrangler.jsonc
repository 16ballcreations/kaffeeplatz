{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaffeeplatz",
  "compatibility_date": "2026-09-30",
  // Sitio estático: solo se sirve lo que genera `npm run build` (dist/).
  "assets": {
    "directory": "./dist"
  },
  // Dirección de pruebas: https://kaffeeplatz.16ballcreations.workers.dev
  // Se mantiene aunque llegue el dominio, para revisar sin tocarlo.
  "workers_dev": true,
  // Dominio propio. Cloudflare crea solo los registros DNS de estas rutas;
  // el canonical de cada pagina apunta al dominio sin www (SITE_URL), asi que
  // en buscadores no compiten.
  "routes": [
    { "pattern": "kaffeeplatz.co", "custom_domain": true },
    { "pattern": "www.kaffeeplatz.co", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
