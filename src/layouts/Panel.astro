---
/**
 * Panel — el armazón del panel de administración.
 *
 * POR QUE NO REUTILIZA `Base.astro`
 * ===========================================================================
 * `Base.astro` trae la cabecera de la tienda, el menú público, el pie con los
 * envíos, los dos botones flotantes de WhatsApp y del carrito, y el JSON-LD y
 * el Open Graph de `SEO.astro`. Nada de eso tiene sentido en el panel, y dos de
 * esas cosas serían un error: anunciar el panel a los buscadores (justo lo
 * contrario del `noindex` que pide el encargo) y ofrecerle a la dueña el botón
 * de «¿te ayudamos a elegir?» mientras edita su propio catálogo.
 *
 * Lo que SI reutiliza es lo que importa para que el panel se sienta del mismo
 * sitio: los **tokens** de `v2.css` (colores, tipografía, radios) y las clases
 * de botón que ya existen. El CSS propio del panel está en `panel.css`, aparte,
 * para no engordar `v2.css` — que es una restricción del encargo y, de fondo,
 * la separación correcta: el panel y la tienda cambian por motivos distintos.
 *
 * `noindex`: DOS CAPAS, Y LA QUE MANDA ES LA CABECERA
 * ---------------------------------------------------------------------------
 * Aquí va el `<meta name="robots">`, igual que `page()` de 16bc. Pero la capa
 * que de verdad protege es la cabecera HTTP `X-Robots-Tag`, que pone el
 * middleware para TODA respuesta de `/admin` (ver `src/admin/puerta.ts`):
 * cubre también lo que no es HTML y no depende de que un buscador lea el
 * documento. Y el panel no está en el sitemap porque `sitemap.xml.ts` solo
 * lista productos, artículos y las seis rutas fijas del sitio público; no hay
 * nada que quitar, y hay una prueba que lo comprueba.
 *
 * `prerender = false` ES UN REQUISITO DE SEGURIDAD, NO UNA OPTIMIZACION
 * ---------------------------------------------------------------------------
 * Lo declara cada página del panel. Si una se prerenderizara, saldría como
 * fichero HTML en `dist/` y el borde la serviría como asset **sin ejecutar el
 * Worker**: la puerta no se enteraría y la página quedaría pública. Por eso
 * `scripts/verificar-puerta.mjs` falla el build si encuentra HTML de `/admin`
 * en `dist/`.
 */
import { SITIO, ruta, recurso } from '../datos/sitio';
import { SECCIONES } from '../admin/menu';
import '../styles/v2.css';
/* El CSS del panel, en tres ficheros por responsabilidad (y por el límite de
   300 líneas del encargo): el armazón, la portada y las formas. Se cargan los
   tres desde el layout para que ninguna página tenga que acordarse: una
   pantalla a la que le falte el CSS de sus campos es un fallo que no da error,
   solo se ve mal. El coste es un CSS pequeño y cacheado, y el panel no compite
   por el presupuesto de la tienda porque no lo carga ningún cliente. */
import '../styles/panel.css';
import '../styles/panel-portada.css';
import '../styles/panel-formas.css';

interface Props {
  titulo: string;
  /** Clave de la sección activa del menú. Ver `src/admin/menu.ts`. */
  seccion?: string;
  /** El armazón completo (barra + menú + pie) o solo el lienzo, para entrar. */
  desnudo?: boolean;
}

const { titulo, seccion, desnudo = false } = Astro.props as Props;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Capa 1 del noindex. La que manda es la cabecera HTTP del middleware. */}
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#0f0e0d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={recurso('/img/marca/icono.png')} type="image/png" sizes="180x180" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Geist:wght@300;400;500;600&display=swap"
    />
    {/* El título lleva "Panel" delante: en una pestaña entre varias, deja claro
        de un vistazo cuál es la de administrar y cuál la tienda. */}
    <title>Panel · {titulo} · {SITIO.nombre}</title>
  </head>

  <body class="p-cuerpo">
    {
      !desnudo && (
        <>
          <header class="p-barra">
            <div class="p-limite p-barra__fila">
              <a class="p-barra__marca" href={ruta('/admin')}>
                <img src={recurso('/img/marca/emblema-sm.webp')} alt="" width="26" height="26" />
                <span>Panel</span>
              </a>

              {/* Ver la tienda: se abre en otra pestaña para no perder lo que
                  se esté editando. */}
              <a
                class="p-salir"
                href={ruta('/')}
                target="_blank"
                rel="noopener"
              >
                Ver la tienda
              </a>

              {/* Salir es un POST, no un enlace: cerrar sesión cambia el
                  estado del servidor, y un GET que cambia estado se puede
                  provocar desde fuera con una simple <img>. Con POST, además,
                  pasa por la comprobación de `Origin` de la puerta. */}
              <form method="post" action={ruta('/admin/salir')}>
                <button class="p-salir" type="submit">Salir</button>
              </form>
            </div>
          </header>

          <nav class="p-menu" aria-label="Secciones del panel">
            <div class="p-limite">
              <ul>
                {SECCIONES.map((s) => (
                  <li>
                    {s.listo ? (
                      <a
                        href={ruta(s.href)}
                        aria-current={s.clave === seccion ? 'page' : undefined}
                      >
                        {s.etiqueta}
                      </a>
                    ) : (
                      /* Sin enlace a propósito: enseña el mapa sin llevar a un
                         404. `title` dice por qué está apagada. */
                      <span class="p-menu__pronto" title="Todavía no está disponible">
                        {s.etiqueta}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        </>
      )
    }

    <main class={desnudo ? '' : 'p-principal'}>
      {desnudo ? <slot /> : <div class="p-limite"><slot /></div>}
    </main>

    {
      !desnudo && (
        <div class="p-limite">
          <div class="p-pie">
            <span>
              {SITIO.nombre} · panel de {SITIO.dueña}
            </span>
            <span>
              ¿Algo no cuadra? Escribe a{' '}
              <a href={`https://wa.me/${SITIO.whatsappNumero}`}>soporte</a>.
            </span>
          </div>
        </div>
      )
    }
  </body>
</html>
