---
/**
 * Base — layout de la propuesta D "OBSIDIANA II".
 *
 * Evolucion de Obsidiana (C) con tres objetivos: mas conversion por WhatsApp,
 * un catalogo mas vistoso y un sistema visual mas pulido. Conserva los
 * invariantes de la base: SEO.astro intacto, enlace de salto, landmarks, un
 * solo h1 por pagina, rutas y handles.
 *
 * Novedades frente a C:
 *   - Cabecera fija translucida con la accion de WhatsApp siempre a mano.
 *   - Menu movil con <details>: funciona sin JavaScript.
 *   - Dos flotantes en la esquina, con un interruptor CADA UNO y por motivos
 *     distintos: ver `sinFlotante` y `sinFlotanteCarrito` en las props.
 *
 * El comportamiento (revelado al hacer scroll, cabecera compacta, menu movil)
 * vive en `src/scripts/base.ts`.
 */
import SEO from '../components/SEO.astro';
import type { Miga } from '../components/SEO.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import ContadorCarrito from '../components/ContadorCarrito.astro';
import Icono from '../components/Icono.astro';
import FlotanteCarrito from '../components/FlotanteCarrito.astro';
import { SITIO, NAVEGACION, ruta, recurso } from '../datos/sitio';
import { ENVIOS } from '../datos/guias';
import { paraCompartir } from '../datos/imagenes';
import '../styles/v2.css';

interface Props {
  titulo: string;
  descripcion: string;
  camino: string;
  imagen?: string;
  tipoOg?: 'website' | 'article';
  migas?: Miga[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  claseCuerpo?: string;
  /**
   * Oculta el boton flotante de WHATSAPP, y SOLO ese.
   *
   * Se activa donde la pagina ya ofrece ese canal de forma prominente: la
   * ficha (barra inferior con "Pedir") y contacto (la pagina ES el canal).
   * Repetirlo flotando seria el mismo boton dos veces.
   */
  sinFlotante?: boolean;
  /**
   * Oculta el acceso flotante al CARRITO. Por defecto NO se oculta.
   *
   * Existe aparte de `sinFlotante` porque los dos botones tienen motivos
   * distintos para existir y, por tanto, para desaparecer. El de WhatsApp es
   * un canal que algunas paginas ya ofrecen; el del carrito es el estado de
   * la visita, y ese estado importa en TODAS las paginas — sobre todo en la
   * ficha, que es donde se agrega. Estaban unidos por un error de montaje:
   * `sinFlotante` de la ficha apagaba los dos y el carrito desaparecia justo
   * donde mas se usa.
   *
   * Hoy NINGUNA pagina la activa. Es una valvula para el dia que alguna
   * pagina necesite la esquina libre (p. ej. un visor a pantalla completa),
   * no un ajuste que haya que recordar poner.
   */
  sinFlotanteCarrito?: boolean;
}

const {
  titulo,
  descripcion,
  camino,
  imagen,
  tipoOg,
  migas,
  jsonLd,
  claseCuerpo = '',
  sinFlotante = false,
  sinFlotanteCarrito = false,
} = Astro.props as Props;

const anio = new Date().getFullYear();
/* Imagen al compartir: la de la pagina si trae una (producto, articulo) y,
   si no, la tarjeta de marca de 1200x630 (npm run imagen-social). */
const imagenSocial = imagen ? paraCompartir(imagen) : '/img/marca/compartir.jpg';

/* La seccion activa tambien cuenta en subrutas: /producto/x marca Catalogo,
   /diario/x marca Diario. */
const activo = (href: string) =>
  href === '/'
    ? camino === '/'
    : camino === href ||
      camino.startsWith(`${href}/`) ||
      (href === '/catalogo' && camino.startsWith('/producto/'));
---

<!doctype html>
{/* data-kp-base lleva el `base` de Astro al navegador: el modulo del carrito
    arma enlaces a /producto/<handle> desde JavaScript y necesita el mismo
    prefijo que `ruta()` pone en el servidor. */}
<html lang="es-CO" data-kp-base={import.meta.env.BASE_URL.replace(/\/$/, '')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#151413" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={recurso('/img/marca/icono.png')} type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href={recurso('/img/marca/icono.png')} />

    {/* Cormorant Garamond se mantiene: es la firma aprobada de Obsidiana.
        Geist sustituye a Inter en cuerpo e interfaz: mas caracter, cifras
        tabulares limpias para los precios. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Geist:wght@300;400;500;600&display=swap"
    />

    <SEO
      titulo={titulo}
      descripcion={descripcion}
      camino={camino}
      imagen={imagenSocial}
      tipoOg={tipoOg}
      migas={migas}
      jsonLd={jsonLd}
    />
    <slot name="head" />
  </head>

  <body class={`v2 ${claseCuerpo}`.trim()} data-kp-pagina={camino}>
    <a class="kp-saltar" href="#contenido">Saltar al contenido</a>

    <header data-kp-cabecera class="v-cabecera">
      <div class="v-limite v-cabecera__fila">
        <a href={ruta('/')} data-kp-logo class="v-logo" aria-label={`${SITIO.nombre}, inicio`}>
          <img
            src={recurso('/img/marca/emblema-sm.webp')}
            alt=""
            class="v-logo__emblema"
            width="320"
            height="320"
            loading="eager"
            decoding="sync"
          />
          <span class="v-logo__nombre">{SITIO.nombre}</span>
        </a>

        <nav aria-label="Navegación principal" data-kp-nav class="v-nav">
          <ul>
            {
              NAVEGACION.map((i) => (
                <li>
                  <a href={ruta(i.href)} aria-current={activo(i.href) ? 'page' : undefined}>
                    {i.etiqueta}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        {/* El carrito va ANTES del CTA de WhatsApp y fuera de la navegacion
            principal: es un estado de la visita, no una seccion del sitio. */}
        <ContadorCarrito clase="v-cabecera__carrito" />

        <BotonWhatsApp clase="v-boton v-boton--oro v-boton--sm v-cabecera__cta">
          <Icono nombre="whatsapp" tam={18} />
          <span>Escríbenos</span>
        </BotonWhatsApp>

        {/* Menu movil: <details> nativo, abre y cierra sin JavaScript. */}
        <details class="v-menu">
          <summary aria-label="Abrir menú">
            <span class="v-menu__barras" aria-hidden="true"><span></span><span></span></span>
          </summary>
          <div class="v-menu__panel">
            <ul>
              {
                NAVEGACION.map((i, n) => (
                  <li style={`--i:${n}`}>
                    <a href={ruta(i.href)} aria-current={activo(i.href) ? 'page' : undefined}>
                      {i.etiqueta}
                    </a>
                  </li>
                ))
              }
              {/* El carrito cierra la lista, separado: no es una seccion. */}
              <li style={`--i:${NAVEGACION.length}`} class="v-menu__carrito">
                <a href={ruta('/carrito')} aria-current={camino === '/carrito' ? 'page' : undefined}>
                  Carrito
                </a>
              </li>
            </ul>
            <BotonWhatsApp clase="v-boton v-boton--oro">
              <Icono nombre="whatsapp" tam={20} />
              <span>Escríbenos por WhatsApp</span>
            </BotonWhatsApp>
            <p class="v-menu__nota">
              Te responde {SITIO.dueña}. Lunes a viernes, 9:00 a.m. a 6:00 p.m.
            </p>
          </div>
        </details>
      </div>
    </header>

    <main id="contenido" data-kp-main>
      <slot />
    </main>

    <footer data-kp-pie class="v-pie">
      <div class="v-limite">
        <div class="v-pie__cta">
          <img
            src={recurso('/img/marca/emblema-sm.webp')}
            alt=""
            class="v-pie__emblema"
            width="320"
            height="320"
            loading="lazy"
          />
          <p class="v-pie__lema">{SITIO.lema}</p>
        </div>

        <div class="v-pie__rejilla">
          <div>
            <h2>Tienda</h2>
            <ul>
              {
                NAVEGACION.map((i) => (
                  <li>
                    <a href={ruta(i.href)}>{i.etiqueta}</a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h2>Envíos a todo Colombia</h2>
            <ul class="v-pie__envios">
              {
                ENVIOS.map((e) => (
                  <li>
                    <span>{e.zona}</span>
                    <span class="v-num">{e.plazo}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h2>Atención</h2>
            <p data-kp-pie-contacto>
              <a href={`https://wa.me/${SITIO.whatsappNumero}`} class="v-num">{SITIO.whatsappVisible}</a>
            </p>
            <p>
              <a href={`mailto:${SITIO.email}`}>{SITIO.email}</a>
            </p>
            <p>Lunes a viernes, 9:00 a.m. a 6:00 p.m.</p>
            <p>{SITIO.ciudad}. Tienda 100% online.</p>
          </div>
        </div>

        <div class="v-pie__legal">
          <p data-kp-pie-copy>© {anio} {SITIO.nombre}</p>
          {/* Fase 1 del carrito: ya se arma el pedido en el sitio, pero el
              pago sigue siendo por WhatsApp. El texto dice exactamente eso:
              prometer un pago en linea que no existe seria mentir. */}
          <p>Arma tu pedido y lo cerramos por WhatsApp. Todavía sin pago en línea.</p>
        </div>
      </div>
    </footer>

    {/* DOS CONDICIONES INDEPENDIENTES, a proposito.

        El carrito va primero en el marcado y encima en pantalla, y solo
        aparece si hay algo dentro (lo decide su propio script). Se pinta
        aunque la pagina apague el de WhatsApp: son decisiones distintas.

        `claseCuerpo` llega al <body>, asi que la ficha (v-con-barra) puede
        subir el carrito por encima de su barra inferior desde CSS, sin que
        el layout tenga que saber nada de esa pagina. */}
    {!sinFlotanteCarrito && <FlotanteCarrito />}
    {
      !sinFlotante && (
        <BotonWhatsApp clase="v-flotante" data-v-flotante>
          <Icono nombre="whatsapp" tam={26} />
          <span class="v-flotante__texto">¿Te ayudamos a elegir?</span>
        </BotonWhatsApp>
      )
    }

    <script>
      /* Los tres comportamientos del armazon (revelado, cabecera compacta,
         menu movil) viven en su propio modulo: este layout paso de 300 lineas
         al separar las condiciones de los dos flotantes. */
      import '../scripts/base';
    </script>
  </body>
</html>
