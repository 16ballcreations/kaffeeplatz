---
/**
 * Imagen — <img> optimizado para las imagenes de public/img.
 *
 * `alt` es OBLIGATORIO (lo exige el tipo). Por defecto carga en lazy.
 *
 * Para rutas de public/ ("/img/...") pinta la version WebP con `srcset`
 * (320/640/960/completa, ver src/datos/imagenes.ts) y el navegador descarga
 * solo el ancho que necesita segun `tamanos`. Tambien emite width/height
 * reales para reservar el hueco antes de que llegue la foto.
 *
 * `tamanos` es el atributo `sizes`: cuanto ocupa la imagen en pantalla. Pasalo
 * siempre que la imagen no ocupe todo el ancho, o el navegador bajara la
 * version grande.
 *
 * Si se pasa un ImageMetadata importado de src/assets/, lo optimiza
 * astro:assets.
 */
import { Image } from 'astro:assets';
import { fuentes } from '../datos/imagenes';

interface Props {
  /** Ruta "/img/..." de public/, o un ImageMetadata importado de src/assets/. */
  src: string | ImageMetadata;
  /** Texto alternativo. Obligatorio: si es decorativa, pasa alt="". */
  alt: string;
  ancho?: number;
  alto?: number;
  /** Atributo `sizes`. Por defecto, todo el ancho de la ventana. */
  tamanos?: string;
  /** "lazy" por defecto; usa "eager" solo para la imagen principal del hero. */
  cargando?: 'lazy' | 'eager';
  clase?: string;
  /** Para la imagen LCP. */
  prioridad?: boolean;
  [key: string]: unknown;
}

const {
  src,
  alt,
  ancho,
  alto,
  tamanos = '100vw',
  cargando = 'lazy',
  clase = '',
  prioridad = false,
  ...resto
} = Astro.props as Props;

const esRutaPublica = typeof src === 'string';
const f = esRutaPublica ? fuentes(src as string) : undefined;
---

{
  f ? (
    <img
      src={f.src}
      srcset={f.srcset}
      sizes={f.srcset ? tamanos : undefined}
      alt={alt}
      width={ancho ?? f.ancho}
      height={alto ?? f.alto}
      loading={prioridad ? 'eager' : cargando}
      decoding={prioridad ? 'sync' : 'async'}
      fetchpriority={prioridad ? 'high' : undefined}
      class={clase}
      {...resto}
    />
  ) : (
    <Image
      src={src as ImageMetadata}
      alt={alt}
      width={ancho}
      height={alto}
      loading={prioridad ? 'eager' : cargando}
      decoding={prioridad ? 'sync' : 'async'}
      class={clase}
      {...resto}
    />
  )
}
