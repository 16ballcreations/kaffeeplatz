---
/**
 * TarjetaProducto — tarjeta de catalogo, propuesta D "Obsidiana II".
 *
 * Conserva los ganchos data-kp-* de la base y anade lo que el catalogo nuevo
 * necesita para vender mejor:
 *   - Segunda foto al pasar el cursor, si el producto la tiene.
 *   - Categoria en texto, para orientarse sin leer el titulo entero.
 *   - Resumen de opciones reales ("3 colores", "2 tamaños").
 *   - Fila de acciones: ver AccionesTarjeta.astro.
 *
 * LA FILA DE ACCIONES VIVE EN SU PROPIO COMPONENTE
 * ---------------------------------------------------------------------------
 * Antes era una sola accion de WhatsApp a ancho completo y cabia aqui. Ahora
 * son DOS (compra + WhatsApp) con tres casos distintos —una variante, varias
 * variantes, agotado—, su propio script y su propia hoja. Todo eso se fue a
 * `AccionesTarjeta.astro` para que este fichero siga ocupandose solo de la
 * tarjeta: foto, categoria, titulo y precio. El limite de ~300 lineas por
 * fichero es una restriccion vigente del cliente.
 *
 * El enlace a la ficha y las acciones son hermanos, nunca anidados: un <a>
 * dentro de otro <a> es HTML invalido.
 */
/* FASE 3: el tipo viene de src/datos/formas.ts y no de astro:content.
   Es LA MISMA forma que antes devolvia `getCollection('productos').data` —a
   proposito, para que este componente no se entere de que los datos ahora
   llegan de D1 (B.3, opcion B)— pero declarada en un sitio que no depende de
   las colecciones de Astro. */
import type { Producto } from '../datos/formas';
import Imagen from './Imagen.astro';
import Precio from './Precio.astro';
import AccionesTarjeta from './AccionesTarjeta.astro';
import { ruta } from '../datos/sitio';
import { categoriaPorId } from '../datos/categorias';
import { obtenerCategorias, marcarCacheCorta } from '../datos/catalogo';
import { textoQueda } from '../scripts/queda';
/* El «Queda 1»: hoja propia, ver su cabecera. */
import '../styles/queda.css';
import { resumenOpciones } from '../datos/guias';

interface Props {
  producto: Producto;
  clase?: string;
  /** "eager" para las primeras tarjetas visibles. */
  prioridad?: boolean;
  mostrarPrecio?: boolean;
  /** Muestra la fila de acciones (compra + WhatsApp) al pie de la tarjeta. */
  conAccion?: boolean;
}

const {
  producto,
  clase = '',
  prioridad = false,
  mostrarPrecio = true,
  conAccion = true,
} = Astro.props as Props;

const [portada, segunda] = producto.imagenes;
const enlace = ruta(`/producto/${producto.handle}`);
const hayRango = new Set(producto.variantes.map((v) => v.precio)).size > 1;
/* El nombre de D1, el que edita la dueña. `obtenerCategorias` recuerda la
   lectura por peticion: veinticinco tarjetas son una sola consulta, la misma
   que ya hizo la pagina. */
const categoria = categoriaPorId(producto.categoria, await obtenerCategorias(Astro.locals)).nombre;
const opciones = resumenOpciones(producto.opciones);
/* «QUEDA 1» SOLO CON UNA VARIANTE. Con varias, la tarjeta no sabe cuál
   quiere la persona: decir «Queda 1» del producto cuando es solo del color
   verde seria mentir sobre los otros. Eso lo dice la ficha, al elegir. Con el
   inventario apagado no hay `stockDisponible` y esto es siempre null. */
const unica = producto.variantes.length === 1 ? producto.variantes[0] : undefined;
const queda = producto.disponible && unica ? textoQueda(unica.stockDisponible) : null;
/* R15: una pagina con este aviso no se guarda cinco minutos en el borde. */
if (queda) marcarCacheCorta(Astro.locals);
/* En el marcado, el aviso va PEGADO a la expresion del «Agotado», sin salto:
   cada salto entre expresiones de Astro deja un espacio en el HTML aunque la
   expresion no pinte nada (un comentario de JSX tambien), y con el
   inventario apagado la tarjeta tiene que salir identica, byte a byte (R13). */
/** Foto con fondo propio (JPG en origen) frente a recorte sobre blanco. */
/** Ancho en pantalla de la foto de la tarjeta: 3 columnas de ~400 px en
    escritorio, 2 en tableta, carril de 78vw o rejilla de 2 en movil. */
const TAMANOS = "(max-width: 640px) 78vw, (max-width: 1024px) 45vw, 400px";
const esFoto = (src: string) => (/\.jpe?g$/i.test(src) ? 'true' : undefined);
---

<article
  class={`v-tarjeta ${clase}`.trim()}
  data-kp-tarjeta
  data-kp-disponible={String(producto.disponible)}
>
  <a href={enlace} data-kp-tarjeta-enlace class="v-tarjeta__enlace">
    <div data-kp-tarjeta-media class="v-tarjeta__media" data-doble={segunda ? 'true' : undefined}>
      {
        portada ? (
          <Imagen
            src={portada.src}
            alt={portada.alt}
            prioridad={prioridad}
            clase="v-tarjeta__img"
            tamanos={TAMANOS}
            data-foto={esFoto(portada.src)}
          />
        ) : (
          <span data-kp-sin-imagen>Sin imagen</span>
        )
      }
      {
        segunda && (
          <Imagen
            src={segunda.src}
            alt=""
            clase="v-tarjeta__img v-tarjeta__img--2"
            tamanos={TAMANOS}
            data-foto={esFoto(segunda.src)}
          />
        )
      }
      {
        !producto.disponible && (
          <span data-kp-cinta-agotado class="v-tarjeta__estado" aria-hidden="true">
            Agotado
          </span>
        )
      }
    </div>

    <div data-kp-tarjeta-cuerpo class="v-tarjeta__cuerpo">
      <p class="v-tarjeta__categoria">
        {categoria}
        {opciones && <span> · {opciones}</span>}
      </p>
      <h3 data-kp-tarjeta-titulo class="v-tarjeta__titulo">{producto.titulo}</h3>
      {
        mostrarPrecio && (
          <p data-kp-tarjeta-precio class="v-tarjeta__precio">
            <Precio
              precioFormateado={producto.precioFormateado}
              precio={producto.precio}
              desde={hayRango}
            />
          </p>
        )
      }
      {queda && <p class="v-queda v-queda--tarjeta" data-kp-queda>{queda}</p>}{!producto.disponible && <p data-kp-agotado class="sr-only">Agotado</p>}
    </div>
  </a>

  {conAccion && <AccionesTarjeta producto={producto} />}
</article>
