---
/**
 * /diario — Indice del diario, con filtro por tema.
 *
 * Los recuentos salen SIEMPRE del dato (articulos.length, conteo por
 * categoria): anadir o retirar articulos no desactualiza ningun texto.
 */
import Base from '../../layouts/Base.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { ruta } from '../../datos/sitio';
import { CATEGORIAS_DIARIO } from '../../datos/categorias';
import FiltrosCategoria from '../../components/FiltrosCategoria.astro';
import { obtenerArticulos, obtenerTemas } from '../../datos/diario';
import { respuestaDeEmergencia, marcarEtiquetas } from '../../datos/catalogo';


/* FASE 3: el indice del diario lee de D1 y deja de prerenderizarse, para que
   un articulo nuevo aparezca sin despliegue (B.3). */
export const prerender = false;

const [lectura, lecturaTemas] = await Promise.all([
  obtenerArticulos(Astro.locals),
  obtenerTemas(Astro.locals),
]);
if (lectura.estado !== 'ok' || !lectura.datos) {
  return respuestaDeEmergencia(Astro.url, lectura);
}
marcarEtiquetas(Astro.locals, ['diario']);

/* Ya vienen de la consulta por fecha descendente, con el `handle` como
   desempate: hay articulos que comparten fecha y sin el segundo criterio el
   diario podria reordenarse entre peticiones sin que cambiara ningun dato. */
const articulos = lectura.datos;

/* Solo se ofrecen los temas que tienen articulos, con su recuento real. */
const conteo = new Map<string, number>();
for (const a of articulos) {
  conteo.set(a.categoria, (conteo.get(a.categoria) ?? 0) + 1);
}

/* FASE 7: los temas salen de D1 (los edita la dueña en el panel). Si esa
   lectura falla, la lista de categorias.ts: los filtros con los nombres de
   ayer son mejores que un diario sin pintar. */
const temas =
  lecturaTemas.estado === 'ok' && lecturaTemas.datos?.length ? lecturaTemas.datos : CATEGORIAS_DIARIO;

const temasConArticulos = temas.filter((c) => (conteo.get(c.id) ?? 0) > 0).sort(
  (a, b) => a.orden - b.orden,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Diario KaffeePlatz',
  description: 'Guías y apuntes sobre café de especialidad y métodos de preparación.',
  blogPost: articulos.map((a) => ({
    '@type': 'BlogPosting',
    headline: a.titulo,
    datePublished: a.fecha.toISOString().slice(0, 10),
    author: { '@type': 'Person', name: a.autor },
    url: new URL(ruta(`/diario/${a.handle}`), Astro.site).toString(),
  })),
};
---

<Base
  titulo="Diario"
  descripcion="Guías prácticas de café de especialidad: métodos, molienda, conservación y errores comunes al preparar café en casa."
  camino="/diario"
  migas={[{ nombre: 'Diario', href: '/diario' }]}
  jsonLd={jsonLd}
>
  <header data-kp-seccion="encabezado" class="v-encabezado v-limite">
    <div class="v-encabezado__interior">
      <p data-kp-kicker>Lecturas</p>
      <h1>Diario</h1>
      <p data-kp-entradilla>
        Lo que hemos ido aprendiendo preparando café: cómo funciona cada método, qué molienda pide,
        cómo conservar el grano y en qué solemos equivocarnos. {articulos.length} artículos.
      </p>
    </div>
  </header>

  <section aria-label="Artículos" class="v-limite v-seccion--corta">
    {/* Mismo componente que /catalogo: una sola implementacion de filtros. */}
    <FiltrosCategoria
      categorias={temasConArticulos}
      conteo={conteo}
      total={articulos.length}
      objetivo='[data-kp-rejilla="articulos"]'
      etiqueta="Filtrar artículos por tema"
      sustantivo="artículo"
      textoVacio="No hay artículos en este tema."
    />

    <ul data-kp-rejilla="articulos">
      {
        articulos.map((a, i) => (
          <li data-categoria={a.categoria}>
            <TarjetaArticulo articulo={a} prioridad={i < 3} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
