---
/**
 * /diario/[handle] — Articulo del diario. 16 paginas.
 */
import Base from '../../layouts/Base.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import ArticuloCompleto from './_ArticuloCompleto.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import { SITIO, ruta } from '../../datos/sitio';
import { GUIA_DE_PRODUCTO } from '../../datos/guias';
import { obtenerArticulo, obtenerArticulos, articuloRetirado } from '../../datos/diario';
import { conStock } from '../../datos/inventario';
import {
  obtenerProductos,
  respuestaDeEmergencia,
  marcarEtiquetas,
} from '../../datos/catalogo';


/* FASE 3: los 16 articulos pasan a servirse desde D1. Las URLs NO cambian
   (R3): sigue siendo /diario/<handle> exacto. */
export const prerender = false;

const handle = Astro.params.handle!;

/* El articulo con su cuerpo, y la lista para "sigue leyendo". Dos consultas:
   la lista NO trae los cuerpos (16 artículos de varios kB cada uno) porque
   solo necesita titulo, fecha, resumen y portada. Ver consultas/diario.ts. */
const [lectura, lecturaTodos] = await Promise.all([
  obtenerArticulo(Astro.locals, handle),
  obtenerArticulos(Astro.locals),
]);
if (lectura.estado !== 'ok' || lecturaTodos.estado !== 'ok') {
  return respuestaDeEmergencia(Astro.url, lectura);
}

const articulo = lectura.datos;
if (!articulo) {
  /* R3: igual que con los productos archivados. Un handle que existio y ya no
     esta publicado es una URL indexada: 301 al indice del diario, que es el
     sitio util mas cercano. Uno que nunca existio, 404. */
  const retirado = await articuloRetirado(Astro.locals, handle);
  if (retirado.estado === 'ok' && retirado.datos) {
    return Astro.redirect(ruta('/diario'), 301);
  }
  return new Response(null, { status: 404 });
}

const todos = lecturaTodos.datos ?? [];

/* Los productos del metodo son un adorno util: si fallan, el articulo se pinta
   sin esa fila en vez de no pintarse. */
const lecturaProductos = await obtenerProductos(Astro.locals);
/* `conStock`: con el inventario encendido, las tarjetas topan por stock como
   en el catalogo. Apagado devuelve el mismo array. */
const productos =
  lecturaProductos.estado === 'ok' ? await conStock(Astro.locals, lecturaProductos.datos ?? []) : [];

marcarEtiquetas(Astro.locals, [`articulo:${handle}`, 'diario']);

/* "Para este método": los productos cuya guia es este articulo (el mismo
   mapa que usa la ficha, leido al reves). Disponibles primero. */
const delMetodo = productos
  .filter((p) => GUIA_DE_PRODUCTO[p.handle] === articulo.handle)
  /* Desempate por `handle`: hay metodos con varios productos igual de
     disponibles, y el `.slice(0, 4)` de abajo hace que un empate decida quien
     entra en la fila. Al leer de D1 el orden de llegada lo pone la base. */
  .sort(
    (a, b) =>
      Number(b.disponible) - Number(a.disponible) ||
      a.handle.localeCompare(b.handle, 'es'),
  )
  .slice(0, 4);
const d = articulo;

const iso = d.fecha.toISOString().slice(0, 10);

const otros = todos
  .filter((a) => a.handle !== d.handle)
  .sort(
    (a, b) =>
      b.fecha.getTime() - a.fecha.getTime() ||
      a.handle.localeCompare(b.handle, 'es'),
  )
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titulo,
  description: d.resumen,
  datePublished: iso,
  dateModified: iso,
  inLanguage: 'es-CO',
  author: { '@type': 'Person', name: d.autor },
  publisher: {
    '@type': 'Organization',
    name: SITIO.nombre,
    url: new URL(ruta('/'), Astro.site).toString(),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(ruta(`/diario/${d.handle}`), Astro.site).toString(),
  },
  ...(d.imagen ? { image: new URL(ruta(d.imagen), Astro.site).toString() } : {}),
};
---

<Base
  titulo={d.titulo}
  descripcion={d.resumen.slice(0, 160)}
  camino={`/diario/${d.handle}`}
  imagen={d.imagen}
  tipoOg="article"
  migas={[
    { nombre: 'Diario', href: '/diario' },
    { nombre: d.titulo, href: `/diario/${d.handle}` },
  ]}
  jsonLd={jsonLd}
>
  {/* El cuerpo del articulo, compartido con la vista previa del panel. */}
  <ArticuloCompleto articulo={d} />

  {
    delMetodo.length > 0 && (
      <section aria-labelledby="t-metodo" class="v-seccion">
        <div class="v-limite v-cabeza-fila">
          <h2 id="t-metodo" class="v-titulo">Para prepararlo en <em>casa</em></h2>
        </div>
        <ul data-kp-rejilla="productos" class="v-carril">
          {delMetodo.map((p) => (
            <li>
              <TarjetaProducto producto={p} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    otros.length > 0 && (
      <section data-kp-seccion="mas-diario" aria-labelledby="t-mas" class="v-seccion v-limite">
        <div class="v-cabeza-fila">
          <h2 id="t-mas" class="v-titulo">Sigue <em>leyendo</em></h2>
        </div>
        <ul data-kp-rejilla="articulos">
          {otros.map((a) => (
            <li>
              <TarjetaArticulo articulo={a} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
