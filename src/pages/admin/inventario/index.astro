---
/**
 * /admin/inventario — «Cuántos tengo» de cada cosa. G.6 del plan.
 *
 * PARA QUIÉN ES ESTA PANTALLA
 * ===========================================================================
 * Para Andreina, con el móvil en la mano, que acaba de cerrar una venta por
 * WhatsApp (G.3, flujo 2). Lo que pidió el cliente, literal: «poder hacer
 * cargas y descuentos de cantidades si se venden por WhatsApp y no por Bold».
 * Así que la pantalla se mide en TOQUES:
 *
 *   vender una unidad por WhatsApp   1 toque  («Vendí 1 por WhatsApp»)
 *   cargar diez que llegaron         3 toques (Cambiar · 10 · Llegó mercancía)
 *   equivocarse                      1 toque  (Deshacer, en la franja de abajo)
 *
 * Vocabulario de G.6 (normativo): ver `src/admin/inventario-textos.ts`. Aquí
 * no aparece «stock», «variante», «reservado» ni ningún id.
 *
 * ARRIBA, EL INTERRUPTOR. Con el inventario apagado la tienda vende como
 * siempre y estas cantidades se pueden ir cargando sin que nada dependa de
 * ellas (G.6, «el día del cambio»). Se dice en la primera línea para que nunca
 * haya duda de si lo que se toca aquí ya afecta a la tienda.
 *
 * Funciona sin JavaScript: formularios POST con 303 (PRG) y `<details>`.
 */
import Panel from '../../../layouts/Panel.astro';
import FilaVariante from '../../../admin/inventario-fila.astro';
import Respuesta, { type Franja, type Pregunta } from '../../../admin/inventario-respuesta.astro';
import { ruta } from '../../../datos/sitio';
import {
  inventarioDelPanel,
  MINUTOS_PARA_DESHACER,
  type FilaInventario,
  type InventarioDelPanel,
} from '../../../datos/inventario';
import {
  ERRORES,
  textoHecho,
  nombreCompleto,
  minutosHasta,
  minutosDesde,
  cuando,
} from '../../../admin/inventario-textos';
import '../../../styles/panel-inventario.css';
import '../../../styles/panel-inventario-avisos.css';

export const prerender = false;

const q = Astro.url.searchParams;
const id = (k: string) => {
  const n = Number(q.get(k));
  return Number.isInteger(n) && n > 0 ? n : null;
};

let inv: InventarioDelPanel | null = null;
try {
  inv = inventarioDelPanel(Astro.locals);
} catch (fallo) {
  console.error('[admin] inventario sin base:', fallo instanceof Error ? fallo.message : fallo);
}

const [lectura, activo, cuadre, cambio] = inv
  ? await Promise.all([inv.todo(), inv.activo(), inv.cuadre(), inv.ultimoCambioDelInterruptor()])
  : [null, false, null, null];
const filas: FilaInventario[] = lectura?.datos ?? [];

/* El paquete abierto («Añadir otra cosa»): solo si sigue pendiente y es de
   WhatsApp. Un enlace viejo a un paquete que ya salió no puede dejar los
   botones apuntando a él. */
let paquete = null as Awaited<ReturnType<InventarioDelPanel['paquete']>>['datos'];
if (inv && id('paquete')) {
  const p = (await inv.paquete(id('paquete')!)).datos;
  if (p && p.estado === 'pendiente' && p.origen === 'whatsapp') paquete = p;
}
const paqueteId = paquete?.id ?? null;

/* LA FRANJA: se relee el movimiento y se dice lo que de verdad pasó. */
let franja: Franja | null = null;
if (inv && q.get('hecho') === 'm' && id('m')) {
  const m = (await inv.movimiento(id('m')!)).datos;
  if (m) {
    const reciente = minutosDesde(m.creadoEn) < MINUTOS_PARA_DESHACER;
    const deshecho = (await inv.yaDeshecho({ id: m.id, varianteId: m.varianteId })).datos;
    franja = {
      texto: textoHecho(m),
      deshacer: reciente && !deshecho ? { m: m.id, v: m.varianteId } : undefined,
      paquete:
        m.motivo === 'venta_whatsapp' && m.despachoId
          ? { d: m.despachoId, cliente: paquete?.id === m.despachoId ? paquete.cliente : null }
          : undefined,
    };
  }
} else if (q.get('hecho')) {
  const textos: Record<string, string> = {
    deshecho: 'Listo, deshecho. La cuenta volvió a como estaba.',
    nombrado: 'Listo: el paquete ya lleva el nombre en «Para despachar».',
    'a-la-venta': 'Vuelve a estar a la venta.',
    retirado: 'Retirado de la venta. Cuántos tienes no cambió.',
    encendido: 'Inventario encendido: la tienda ya usa estas cantidades.',
    apagado: 'Inventario apagado: la tienda vende como antes. Las cantidades se conservan.',
  };
  const t = textos[q.get('hecho')!];
  if (t) franja = { texto: t };
}

const error = ERRORES[q.get('error') ?? ''] ?? null;

/* LA PREGUNTA de G.4.2, con los números de AHORA (no los de la URL). */
let pregunta: Pregunta | null = null;
const motivo = q.get('pregunta');
if (inv && (motivo === 'reservado' || motivo === 'sin-stock') && id('v')) {
  const f = filas.find((x) => x.varianteId === id('v'));
  if (f) {
    const vence = motivo === 'reservado' ? (await inv.proximaReserva(f.varianteId)).datos : null;
    pregunta = {
      motivo,
      titulo: nombreCompleto(f.productoTitulo, f.varianteTitulo),
      v: f.varianteId,
      n: Math.min(999, id('n') ?? 1),
      fisico: f.fisico,
      minutos: vence ? minutosHasta(vence) : null,
    };
  }
}

/* EL BUSCADOR: en JavaScript sobre las 30 filas, no en SQL. Es más simple, no
   cuesta una consulta, y evita `LIKE`, que D1 remoto ya rompió una vez. */
const buscado = (q.get('q') ?? '').trim();
const normal = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const visibles = buscado
  ? filas.filter((f) => normal(`${f.productoTitulo} ${f.varianteTitulo}`).includes(normal(buscado)))
  : filas;

/* Agrupadas por producto, y los archivados al final: siguen teniendo
   estantería (G.4.6) pero ya no se venden. */
const grupos = new Map<string, { titulo: string; archivado: boolean; filas: FilaInventario[] }>();
for (const f of visibles) {
  const g = grupos.get(f.productoHandle) ?? { titulo: f.productoTitulo, archivado: f.productoArchivado, filas: [] };
  g.filas.push(f);
  grupos.set(f.productoHandle, g);
}
const ordenados = [...grupos.values()].sort((a, b) => Number(a.archivado) - Number(b.archivado));

/* Cuántas variantes tiene cada producto EN TOTAL (no las que deja ver el
   buscador): con una sola, la fila no repite el nombre del producto. */
const cuantas = new Map<string, number>();
for (const f of filas) cuantas.set(f.productoHandle, (cuantas.get(f.productoHandle) ?? 0) + 1);

const negativos = filas.filter((f) => f.fisico < 0);
const descuadres = cuadre?.datos?.length ?? 0;
const abrir = id('abrir');
---

<Panel titulo="Inventario" seccion="inventario">
  <h1 class="p-titulo">Inventario</h1>
  <p class="p-entradilla">
    Cuántos tienes de cada cosa. Si vendes algo por WhatsApp, un toque en «Vendí 1» lo descuenta y lo
    pone en <a href={ruta('/admin/despachos')}>Para despachar</a>.
  </p>

  {
    !inv || !lectura || lectura.estado === 'sin-datos' ? (
      <p class="p-error" role="alert">
        No se pudo leer el inventario ahora mismo. Si estás en local, corre <code>npm run d1:migrar</code>.
      </p>
    ) : (
      <>
        <div class={`pi-interruptor ${activo ? 'pi-interruptor--on' : ''}`}>
          <p>
            {activo
              ? 'La tienda está usando estas cantidades: lo que llega a 0 sale como Agotado.'
              : 'La tienda todavía NO usa estas cantidades: todo se vende como antes. Cuando termines de contar, enciéndelo.'}
            {cambio && ` (${cambio.accion === 'activar' ? 'Encendido' : 'Apagado'} ${cuando(cambio.cuando)}.)`}
          </p>
          <a class="pi-enlace-boton" href={ruta('/admin/inventario/interruptor')}>
            {activo ? 'Apagar…' : 'Encender…'}
          </a>
        </div>

        <Respuesta parte="pregunta" franja={franja} error={error} pregunta={pregunta} paqueteAbierto={paqueteId} />

        {paquete && (
          <div class="pi-paquete">
            <p>
              Añadiendo al paquete {paquete.cliente ? `de ${paquete.cliente}` : 'de esta venta'}: lleva{' '}
              {paquete.articulos.map((a) => `${a.cantidad} × ${a.titulo}`).join(', ') || 'nada todavía'}.
            </p>
            <a class="pi-enlace-boton" href={ruta('/admin/inventario')}>Terminar</a>
          </div>
        )}

        {(negativos.length > 0 || descuadres > 0) && (
          <ul class="pi-avisos">
            {negativos.length > 0 && (
              <li>
                {negativos.length === 1 ? 'Hay 1 cosa' : `Hay ${negativos.length} cosas`} con menos de lo que dice
                la cuenta: {negativos.map((f) => nombreCompleto(f.productoTitulo, f.varianteTitulo)).join(', ')}.
                Corrige la cuenta cuando sepas cuántos hay.
              </li>
            )}
            {descuadres > 0 && (
              <li>
                La cuenta de {descuadres} {descuadres === 1 ? 'cosa no coincide' : 'cosas no coinciden'} con su
                historial. No es un error tuyo: avisa a soporte para que lo revisen.
              </li>
            )}
          </ul>
        )}

        <form class="pi-buscar" method="get" action={ruta('/admin/inventario')} role="search">
          {paqueteId && <input type="hidden" name="paquete" value={paqueteId} />}
          <label class="sr-only" for="buscar">Buscar</label>
          <input id="buscar" name="q" type="search" value={buscado} placeholder="Buscar: hervidor, chemex…" />
          <button class="pi-boton" type="submit">Buscar</button>
        </form>

        {ordenados.length === 0 && <p class="pi-ok">No hay nada que se llame «{buscado}».</p>}

        {ordenados.map((g) => (
          <section class="pi-producto">
            <h2 class="pi-producto__titulo">
              {g.titulo} {g.archivado && <small>· ya no está en la tienda</small>}
            </h2>
            <ul class="pi-filas">
              {g.filas.map((f) => (
                <FilaVariante
                  fila={f}
                  paquete={paqueteId}
                  abierto={abrir === f.varianteId}
                  unica={cuantas.get(f.productoHandle) === 1}
                />
              ))}
            </ul>
          </section>
        ))}

        <Respuesta parte="franja" franja={franja} error={error} pregunta={pregunta} paqueteAbierto={paqueteId} />
      </>
    )
  }
</Panel>
