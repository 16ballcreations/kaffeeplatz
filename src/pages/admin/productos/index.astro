---
/**
 * /admin/productos — la lista, con buscador y filtros. Y, desde el 9 oct 2026,
 * la entrada al inventario y a las fotos, que ya no tienen pantalla propia.
 *
 * El buscador es un formulario GET normal: funciona sin JavaScript, la URL se
 * puede guardar como favorito («mis agotados») y los avisos de la portada del
 * panel enlazan aquí con `?estado=agotados`, `sin-foto`, `archivados`,
 * `negativo` o `descuadre`. Por eso esos valores son exactamente los de
 * `src/admin/atencion.ts`.
 *
 * CON EL INVENTARIO ENCENDIDO cada fila dice cuántas se pueden vender
 * («Verde 3 · Rosa 0»), con los negativos en rojo, y hay filtros para lo que
 * hay que mirar: stock en negativo, poco stock (1 o 2), sin unidades, cuentas
 * que no cuadran. Apagado, la lista sale como antes y la cabecera lo dice. La
 * cabecera lleva también el interruptor (con su pantalla de confirmación) y
 * «Contar la bodega», para el día del conteo inicial.
 *
 * Lo que enseñaba la antigua lista de fotos va en cada fila: fotos sin
 * publicar y versiones sin foto propia.
 *
 * TARJETAS POR CATEGORIA (nov 2026)
 * ---------------------------------------------------------------------------
 * Petición de la dueña: la lista larga de filas pasa a tarjetas como las del
 * catálogo (ver `TarjetaListado.astro`), agrupadas en una sección por
 * categoría, en el orden de la tienda. Cada título lleva su «Agregar
 * producto», que abre el alta con esa categoría ya elegida: un paso menos al
 * subir algo nuevo. Sin filtros salen TODAS las categorías, también las
 * vacías, para poder añadir el primero; buscando o filtrando por estado,
 * solo las que tienen algo que enseñar. Lo de una categoría que ya no existe
 * va a «Otros», la última, como hace la tienda (`categoriaPorId`).
 *
 * El filtrado es en memoria sobre todas las filas (ver `listarProductos`):
 * así «termometro» encuentra «Termómetro», que es como se escribe en el
 * teléfono.
 */
import Panel from '../../../layouts/Panel.astro';
import Respuesta from '../../../admin/inventario-respuesta.astro';
import TarjetaListado from '../../../admin/productos/TarjetaListado.astro';
import { ruta } from '../../../datos/sitio';
import { baseAdmin } from '../../../admin/base';
import { listarProductos, categoriasDeProducto, type FilaListado } from '../../../admin/productos/leer';
import { normalizarBusqueda } from '../../../admin/productos/texto';
import { inventarioDelPanel, type FilaInventario } from '../../../datos/inventario';
import { respuestaDeInventario, type RespuestaInventario } from '../../../admin/inventario-lectura';
import { nombreVariante, cuando } from '../../../admin/inventario-textos';
import '../../../styles/panel-productos.css';
import '../../../styles/panel-productos-tarjetas.css';
import '../../../styles/panel-inventario.css';
import '../../../styles/panel-inventario-avisos.css';

export const prerender = false;

/* --- El inventario: se lee aparte y nunca tumba la lista ------------------ */
const stock = new Map<string, FilaInventario[]>();
const descuadre = new Set<string>();
const descuadres: string[] = [];
let activo = false;
let cambio: { cuando: string; accion: string } | null = null;
let sinInventario = false;
let respuesta: RespuestaInventario = { franja: null, pregunta: null, error: null, paquete: null };
try {
  const inv = inventarioDelPanel(Astro.locals);
  const [todo, a, c, u] = await Promise.all([inv.todo(), inv.activo(), inv.cuadre(), inv.ultimoCambioDelInterruptor()]);
  activo = a;
  cambio = u;
  for (const f of todo.datos ?? []) stock.set(f.productoHandle, [...(stock.get(f.productoHandle) ?? []), f]);
  const handleDe = new Map((todo.datos ?? []).map((f) => [f.varianteId, f.productoHandle]));
  for (const d of c.datos ?? []) {
    const h = handleDe.get(d.variante_id);
    if (h) descuadre.add(h);
    descuadres.push(`${d.producto_titulo}${nombreVariante(d.titulo) ? ` — ${d.titulo}` : ''}`);
  }
  sinInventario = todo.estado !== 'ok';
  respuesta = await respuestaDeInventario(inv, Astro.url.searchParams, []);
} catch (fallo) {
  console.error('[admin] lista sin inventario:', fallo instanceof Error ? fallo.message : fallo);
  sinInventario = true;
}
const de = (p: FilaListado) => stock.get(p.handle) ?? [];
/** Las versiones a la venta de un producto vivo: las que cuentan para «poco» y «sin unidades». */
const enVenta = (p: FilaListado) => (p.archivado ? [] : de(p).filter((v) => v.aLaVenta));

/** Los estados del filtro. `tienda` es lo que se ve en el sitio: el valor por defecto. */
const ESTADOS: { id: string; nombre: string; vale: (p: FilaListado) => boolean; inventario?: boolean }[] = [
  { id: 'tienda', nombre: 'En la tienda', vale: (p) => !p.archivado },
  { id: 'agotados', nombre: 'Agotados', vale: (p) => !p.archivado && !p.disponible },
  { id: 'sin-foto', nombre: 'Sin foto', vale: (p) => !p.archivado && p.fotos === 0 },
  { id: 'fotos', nombre: 'Fotos por revisar', vale: (p) => p.porRevisar > 0 || (!p.archivado && p.sinFotoPropia.length > 0) },
  /* Los de inventario, solo con el inventario encendido (apagado, nadie lleva
     la cuenta y un «−2» sería ruido). La portada lleva a `negativo` y
     `descuadre`. */
  { id: 'negativo', nombre: 'Stock en negativo', vale: (p) => de(p).some((v) => v.fisico < 0), inventario: true },
  { id: 'poco', nombre: 'Poco stock (1 o 2)', vale: (p) => enVenta(p).some((v) => v.vendible > 0 && v.vendible <= 2), inventario: true },
  { id: 'sin-stock', nombre: 'Sin unidades', vale: (p) => enVenta(p).some((v) => v.vendible <= 0), inventario: true },
  { id: 'descuadre', nombre: 'Cuentas que no cuadran', vale: (p) => descuadre.has(p.handle), inventario: true },
  { id: 'archivados', nombre: 'Archivados', vale: (p) => p.archivado },
  { id: 'todos', nombre: 'Todos', vale: () => true },
];

const q = (Astro.url.searchParams.get('q') ?? '').trim();
const categoria = Astro.url.searchParams.get('categoria') ?? '';
const estado = ESTADOS.find((e) => e.id === Astro.url.searchParams.get('estado')) ?? ESTADOS[0]!;
const paquete = respuesta.paquete;

let filas: FilaListado[] = [];
let categorias: { id: string; nombre: string }[] = [];
let sinBase = false;
try {
  const db = baseAdmin(Astro.locals);
  [filas, categorias] = await Promise.all([listarProductos(db), categoriasDeProducto(db)]);
} catch (fallo) {
  console.error('[admin] lista de productos:', fallo instanceof Error ? fallo.message : fallo);
  sinBase = true;
  Astro.response.status = 503;
}

const buscado = normalizarBusqueda(q);
const vistas = filas.filter(
  (p) =>
    estado.vale(p) &&
    (!categoria || p.categoria === categoria) &&
    (!buscado || normalizarBusqueda(`${p.titulo} ${p.handle}`).includes(buscado)),
);
const filtrando = Boolean(q || categoria || estado.id !== 'tienda');

/* --- Las secciones --------------------------------------------------------
   «Otros» siempre al final aunque alguien le cambie el orden en la base: es
   el cajón de lo que no encaja. Si la base no la trajera, se crea una sección
   «Otros» solo para enseñar lo huérfano, sin botón (no hay categoría a la que
   cargarlo). */
const conocidas = new Set(categorias.map((c) => c.id));
const OTROS = 'otros';
const huerfanos = conocidas.has(OTROS) ? OTROS : '_otros';
const secciones = [
  ...categorias.filter((c) => c.id !== OTROS),
  ...categorias.filter((c) => c.id === OTROS),
  ...(conocidas.has(OTROS) ? [] : [{ id: huerfanos, nombre: 'Otros' }]),
].map((c) => ({
  ...c,
  alta: conocidas.has(c.id),
  productos: vistas.filter((p) => (conocidas.has(p.categoria) ? p.categoria : huerfanos) === c.id),
}));
/* Las vacías se enseñan solo mirando «lo que está en la tienda» sin buscar
   (con la categoría elegida, solo esa): ahí un hueco invita a añadir el
   primero. Buscando, una sección vacía sería ruido. Con un paquete abierto
   se está vendiendo, no dando de alta: ni vacías ni botones de alta. */
const conVacias = !q && estado.id === 'tienda' && !paquete;
const visibles = secciones.filter(
  (s) => s.productos.length > 0 || (conVacias && s.alta && (!categoria || s.id === categoria)),
);
const altaEn = (id: string) => ruta(`/admin/productos/nuevo?categoria=${encodeURIComponent(id)}`);

/* Los enlaces a la ficha arrastran el paquete abierto: «Añadir otra cosa»
   elige aquí el producto y allí la versión. */
const aFicha = (id: number) => ruta(`/admin/productos/${id}${paquete ? `?paquete=${paquete.id}` : ''}`);
/** «Verde 3 · Rosa 0», o solo el número si hay una sola versión. */
const cifras = (p: FilaListado) =>
  de(p).map((v) => ({
    nombre: de(p).length > 1 ? nombreVariante(v.varianteTitulo) : null,
    n: v.fisico < 0 ? v.fisico : Math.max(0, v.vendible),
    clase: v.fisico < 0 ? 'pl-n--rojo' : v.vendible <= 0 ? 'pl-n--cero' : v.vendible <= 2 ? 'pl-n--poco' : '',
  }));
---

<Panel titulo="Productos" seccion="productos">
  <div class="pp-cabeza">
    <h1 class="p-titulo">Productos</h1>
    <a class="v-boton v-boton--oro" href={ruta('/admin/productos/nuevo')}>Añadir producto</a>
  </div>

  <div data-region="pregunta">
    {
      paquete && (
        <div class="pi-paquete">
          <p>
            {`Añadiendo al paquete ${paquete.cliente ? `de ${paquete.cliente}` : 'de esta venta'}: lleva `}
            {paquete.articulos.map((a) => `${a.cantidad} × ${a.titulo}`).join(', ') || 'nada todavía'}. Elige el
            producto y pulsa «Añadir 1 al paquete» en su versión.
          </p>
          <a class="pi-enlace-boton" href={ruta('/admin/productos')}>Terminar</a>
        </div>
      )
    }
  </div>

  {/* EL INVENTARIO, en la cabecera: si la tienda usa las cantidades o no, el
      interruptor (con su pantalla que pide confirmar) y el conteo. Va en la
      primera línea para que nunca haya duda de si lo que se toca ya afecta a
      la tienda. */}
  <section class={`pi-interruptor ${activo ? 'pi-interruptor--on' : ''}`} id="inventario" aria-label="Inventario">
    <p>
      {
        sinInventario
          ? 'No se pudo leer el inventario ahora mismo.'
          : activo
            ? 'Inventario encendido: la tienda usa las cantidades, y lo que llega a 0 sale como Agotado.'
            : 'Inventario apagado: la tienda vende sin mirar cantidades. Cuando termines de contar, enciéndelo.'
      }
      {cambio && ` (${cambio.accion === 'activar' ? 'Encendido' : 'Apagado'} ${cuando(cambio.cuando)}.)`}
    </p>
    <span class="pl-botones">
      <a class="pi-enlace-boton" href={ruta('/admin/productos/contar')}>Contar la bodega</a>
      <a class="pi-enlace-boton" href={ruta('/admin/inventario/interruptor')}>{activo ? 'Apagar…' : 'Encender…'}</a>
    </span>
  </section>
  {
    descuadres.length > 0 && (
      <ul class="pi-avisos">
        <li>
          {/* Solo los tres primeros nombres: con muchas cuentas descuadradas
              (p. ej. un stock cargado a mano en la base) la lista entera era
              un muro de texto. El resto se ve con el filtro. */}
          {`${descuadres.length === 1 ? 'La cuenta de una cosa no coincide' : `Las cuentas de ${descuadres.length} cosas no coinciden`} con su historial: ${descuadres.slice(0, 3).join(', ')}${descuadres.length > 3 ? ` y ${descuadres.length - 3} más` : ''}. No es un error tuyo: avisa a soporte para que lo revisen. `}
          {descuadres.length > 3 && <a href={ruta('/admin/productos?estado=descuadre')}>Ver todas</a>}
        </li>
      </ul>
    )
  }

  {
    sinBase ? (
      <p class="p-error" role="alert">
        No se pudo conectar con la tienda en este momento. Vuelve a intentarlo en un minuto.
      </p>
    ) : (
      <>
        <form method="get" action={ruta('/admin/productos')} class="pp-buscador" role="search">
          {paquete && <input type="hidden" name="paquete" value={paquete.id} />}
          <div class="pp-campo pp-buscador__q">
            <label class="p-campo__etiqueta" for="b-q">Buscar</label>
            <input id="b-q" name="q" type="search" value={q} placeholder="Chemex, filtro, hervidor…" />
          </div>
          <div class="pp-campo">
            <label class="p-campo__etiqueta" for="b-categoria">Categoría</label>
            <select id="b-categoria" name="categoria">
              <option value="">Todas</option>
              {categorias.map((c) => (
                <option value={c.id} selected={c.id === categoria}>{c.nombre}</option>
              ))}
            </select>
          </div>
          <div class="pp-campo">
            <label class="p-campo__etiqueta" for="b-estado">Mostrar</label>
            <select id="b-estado" name="estado">
              {ESTADOS.filter((e) => !e.inventario || activo || e.id === estado.id).map((e) => (
                <option value={e.id} selected={e.id === estado.id}>{e.nombre}</option>
              ))}
            </select>
          </div>
          <div class="pp-buscador__botones">
            <button class="v-boton v-boton--linea" type="submit">Buscar</button>
            {filtrando && <a href={ruta('/admin/productos')}>Quitar filtros</a>}
          </div>
        </form>

        <p class="pp-cuenta" role="status">
          {vistas.length === 1 ? '1 producto' : `${vistas.length} productos`}
          {filtrando ? ' con estos filtros' : ' en la tienda'}
        </p>

        {visibles.length === 0 ? (
          <p class="p-entradilla">
            No hay productos que coincidan. {filtrando && <a href={ruta('/admin/productos')}>Ver todos</a>}
          </p>
        ) : (
          visibles.map((s) => (
            <section class="pt-seccion" aria-labelledby={`cat-${s.id}`}>
              <div class="pt-seccion__cabeza">
                <h2 class="pt-seccion__titulo" id={`cat-${s.id}`}>
                  {s.nombre} <span class="pt-seccion__cuenta v-num">{s.productos.length}</span>
                  <span class="sr-only">{s.productos.length === 1 ? 'producto' : 'productos'}</span>
                </h2>
                {s.alta && !paquete && (
                  <a class="pi-enlace-boton pt-seccion__alta" href={altaEn(s.id)} aria-label={`Agregar producto en ${s.nombre}`}>
                    <span aria-hidden="true">+</span> Agregar producto
                  </a>
                )}
              </div>
              {s.productos.length === 0 ? (
                <p class="pt-seccion__vacia">Todavía no hay productos aquí.</p>
              ) : (
                <ul class="pt-rejilla">
                  {s.productos.map((p) => (
                    <li>
                      <TarjetaListado
                        p={p}
                        enlace={aFicha(p.id)}
                        activo={activo}
                        cifras={cifras(p)}
                        negativo={de(p).some((v) => v.fisico < 0)}
                      />
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        )}
      </>
    )
  }

  <div data-region="franja">
    <Respuesta
      parte="franja"
      franja={respuesta.franja}
      error={respuesta.error}
      pregunta={null}
      paqueteAbierto={paquete?.id ?? null}
      pantalla="/admin/productos"
      volver="lista"
    />
  </div>
</Panel>
