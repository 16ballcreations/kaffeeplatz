---
/**
 * inventario-fila — una línea de la pantalla de inventario: un color, un
 * tamaño, o el producto entero si no tiene variantes.
 *
 * Vive en `src/admin/` y no junto a la página porque `verificar-puerta.mjs`
 * exige `prerender = false` a TODO fichero de `src/pages/admin/`, y un
 * componente no es una página: así la comprobación sigue siendo estricta.
 *
 * QUÉ SE VE Y POR QUÉ (G.6)
 * ===========================================================================
 *   - UN número grande: lo que puede vender (físico menos lo que alguien está
 *     pagando). Es el que importa. Lo de la estantería y lo apartado salen
 *     debajo SOLO cuando se diferencian: enseñar siempre tres números es
 *     pedirle que aprenda un modelo de datos.
 *   - «Vendí 1 por WhatsApp», el botón más grande: es el 90 % del uso y cuesta
 *     UN toque (G.3). Sin preguntas: el motivo ya lo dice el botón.
 *   - «Cambiar», plegado: «No me queda ninguno» (a 0 en un toque), cargar
 *     mercancía, devoluciones, roturas y corregir la cuenta. Todo con
 *     `<details>`, que se abre sin JavaScript.
 *   - «A la venta» YA NO está aquí: es la casilla de la tarjeta de la versión
 *     en la ficha del producto, que lo guarda con su cerrojo y su auditoría.
 *     Dos interruptores para lo mismo en la misma tarjeta se contradirían.
 *
 * Todos los formularios van a `/admin/inventario/accion` por POST y vuelven
 * con 303 a la pantalla que diga `volver`; ver `src/admin/inventario-acciones.ts`.
 * Con JavaScript, en la ficha del producto, van por `fetch` y solo se
 * sustituye esta fila (`data-inv`, ver productos/cliente-bloques.ts): lo
 * escrito en los demás bloques no se toca.
 */
import type { FilaInventario } from '../datos/inventario';
import { ruta } from '../datos/sitio';
import { nombreVariante } from './inventario-textos';

interface Props {
  fila: FilaInventario;
  /** El paquete abierto (modo «Añadir otra cosa»), si lo hay. */
  paquete: number | null;
  /** Abrir «Cambiar» al pintar: volvió un error de esta fila. */
  abierto: boolean;
  /** Es la única variante del producto: el título ya lo dice la cabecera. */
  unica: boolean;
  /** Clave de vuelta tras el POST (ver `volverA` en inventario-acciones.ts). */
  volver: string;
  /**
   * `li` en una lista; `div` dentro de la tarjeta de la versión en la ficha
   * del producto, donde es un sub-bloque y no un elemento de lista.
   */
  como?: 'li' | 'div';
  /** ¿Usa la tienda las cantidades? Cambia lo que significa estar en 0. */
  activo?: boolean;
}

const { fila: f, paquete, abierto, unica, volver, como = 'li', activo = true } = Astro.props as Props;
const Envoltorio = como;
const accion = ruta('/admin/inventario/accion');

/* Lo que alguien está pagando AHORA: físico menos vendible, que ya descuenta
   solo las reservas vigentes. */
const apartado = Math.max(0, f.fisico - f.vendible);
const negativo = f.fisico < 0;
const numero = negativo ? f.fisico : Math.max(0, f.vendible);
/* Con una sola variante, su nombre repetiría la cabecera del producto: se
   dice lo que es el número. */
const nombre = (!unica && nombreVariante(f.varianteTitulo)) || 'Cuántos tengo';

/* «Agotado (se retiró solo)» y «Retirado por ti» son cosas distintas desde
   migrations/0010: lo primero vuelve solo a la venta al cargar unidades, lo
   segundo no, y es lo que ella tiene que poder distinguir de un vistazo. */
let estado = 'A la venta';
let claseEstado = '';
if (negativo) {
  estado = `Hay menos de lo que dice la cuenta (${f.fisico}). Corrígela cuando sepas cuántos hay.`;
  claseEstado = 'pi-estado--rojo';
} else if (!f.aLaVenta && f.agotadaAuto) {
  estado = 'Agotado: se retiró solo de la venta. Vuelve solo cuando cargues unidades.';
} else if (!f.aLaVenta) {
  estado =
    `Retirado por ti${f.fisico > 0 ? ` — hay ${f.fisico} en la estantería` : ''}. ` +
    'No vuelve a la venta solo: marca «A la venta» cuando quieras venderlo.';
} else if (apartado > 0) {
  estado = `${apartado} lo está pagando alguien ahora · en la estantería hay ${f.fisico}.`;
  claseEstado = 'pi-estado--aviso';
} else if (f.fisico === 0) {
  estado = activo
    ? 'Agotado — en la tienda sale «Agotado» hasta que cargues unidades.'
    : 'Sin unidades en la cuenta. Con el inventario apagado, la tienda lo sigue vendiendo.';
}
---

<Envoltorio class="pi-fila" id={`v${f.varianteId}`} data-inv-fila={f.varianteId}>
  <div class="pi-fila__cabeza">
    <a class="pi-fila__nombre" href={ruta(`/admin/inventario/${f.varianteId}`)}>{nombre}</a>
    <span
      class={`pi-numero ${negativo ? 'pi-numero--rojo' : numero === 0 ? 'pi-numero--cero' : ''}`}
      aria-label={`Puedes vender ${numero}`}>{numero}</span
    >
  </div>
  <p class={`pi-estado ${claseEstado}`}>{estado}</p>

  <div class="pi-fila__acciones">
    <form method="post" action={accion} data-inv>
      <input type="hidden" name="accion" value="whatsapp" />
      <input type="hidden" name="v" value={f.varianteId} />
      <input type="hidden" name="volver" value={volver} />
      {paquete && <input type="hidden" name="paquete" value={paquete} />}
      <button class="v-boton v-boton--oro pi-vender" type="submit">
        {paquete ? 'Añadir 1 al paquete' : 'Vendí 1 por WhatsApp'}
      </button>
    </form>

    <details class="pi-mas" open={abierto}>
      <summary>Cambiar</summary>
      <div class="pi-mas__panel">
        {/* «No me queda ninguno»: la cuenta a 0 en UN toque (pedido del
            cliente, 2 nov 2026: escribía 0 en «¿Cuántas?», que es para sumar
            o restar, y el navegador le exigía al menos 1). Es «Corregir la
            cuenta» con la nota puesta y el mismo cerrojo (`anterior`). Si
            alguien lo está pagando, el servidor pregunta antes. Con la cuenta
            ya en 0 no hay nada que hacer y no sale. */}
        {
          f.fisico !== 0 && (
            <form method="post" action={accion} data-inv class="pi-grupo pi-agotado">
              <input type="hidden" name="accion" value="agotado" />
              <input type="hidden" name="v" value={f.varianteId} />
              <input type="hidden" name="anterior" value={f.fisico} />
              <input type="hidden" name="volver" value={volver} />
              {paquete && <input type="hidden" name="paquete" value={paquete} />}
              <button class="pi-boton pi-boton--rojo" type="submit">No me queda ninguno (poner en 0)</button>
              {/* Solo si está a la venta: lo que retiró ella no vuelve solo. */}
              {activo && f.aLaVenta && <small>Sale de la venta sola, y vuelve sola cuando cargues unidades.</small>}
            </form>
          )
        }

        {/* Un número y el motivo en el botón: «cargar diez en tres toques»
            (abrir, teclear 10, «Llegó mercancía»), que es la prueba 27. Este
            número es CUÁNTAS SE SUMAN O SE QUITAN, no cuántas hay: por eso
            empieza en 1, y la etiqueta lo dice. */}
        <form method="post" action={accion} data-inv class="pi-grupo">
          <input type="hidden" name="accion" value="sumar" />
          <input type="hidden" name="v" value={f.varianteId} />
          <input type="hidden" name="volver" value={volver} />
      {paquete && <input type="hidden" name="paquete" value={paquete} />}
          <label for={`n${f.varianteId}`}>Sumar o quitar: ¿cuántas?</label>
          <input
            class="pi-num"
            id={`n${f.varianteId}`}
            name="n"
            type="number"
            inputmode="numeric"
            min="1"
            max="999"
            value="1"
            required
          />
          <div class="pi-motivos">
            <button class="pi-boton" type="submit" name="motivo" value="entrada">+ Llegó mercancía</button>
            <button class="pi-boton" type="submit" name="motivo" value="devolucion">+ Me devolvieron</button>
            <button class="pi-boton" type="submit" name="motivo" value="whatsapp">− Vendí por WhatsApp</button>
            <button class="pi-boton pi-boton--rojo" type="submit" name="motivo" value="rotura">− Se rompió o se perdió</button>
          </div>
        </form>

        {/* «Corregir la cuenta» es el ÚNICO sitio donde se exige escribir,
            porque es el único donde el motivo no lo explica ya (G.6). El
            número que veía va oculto: si cambió mientras tanto, no se pisa. */}
        <form method="post" action={accion} data-inv class="pi-grupo">
          <input type="hidden" name="accion" value="corregir" />
          <input type="hidden" name="v" value={f.varianteId} />
          <input type="hidden" name="anterior" value={f.fisico} />
          <input type="hidden" name="volver" value={volver} />
      {paquete && <input type="hidden" name="paquete" value={paquete} />}
          <label for={`c${f.varianteId}`}>
            Corregir la cuenta: ¿cuántas hay de verdad? <small>(el número exacto, puede ser 0)</small>
          </label>
          <input
            class="pi-num"
            id={`c${f.varianteId}`}
            name="nuevo"
            type="number"
            inputmode="numeric"
            min="0"
            max="9999"
            value={Math.max(0, f.fisico)}
            required
          />
          {/* Sin `required`: con 0 no hace falta (la nota es «Se agotó»), y
              con otro número la pide el servidor con una frase (ERRORES.nota). */}
          <label for={`t${f.varianteId}`}>¿Por qué? <small>(obligatorio, salvo si pones 0)</small></label>
          <input
            class="pi-texto"
            id={`t${f.varianteId}`}
            name="nota"
            type="text"
            maxlength="200"
            placeholder="Conté la bodega, se rompió una…"
          />
          <button class="pi-boton" type="submit">Guardar la cuenta</button>
        </form>

        <p class="pi-fila__pie"><a href={ruta(`/admin/inventario/${f.varianteId}`)}>Qué pasó con esto →</a></p>
      </div>
    </details>
  </div>
</Envoltorio>
