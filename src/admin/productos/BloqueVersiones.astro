---
/**
 * BloqueVersiones — qué versiones tiene el producto, en qué orden, y cómo se
 * llama lo que cambia entre ellas («Color», «Tamaño»).
 *
 * PARA ANDREINA NO HAY VARIANTES, HAY VERSIONES
 * ===========================================================================
 * Es la palabra del cliente («producto → fotos generales / versión 1 → fotos
 * propias / versión 2…») y la que usa toda la ficha. Aquí no aparecen
 * «variantes», ni ids, ni «Default Title». Un producto que no viene en
 * colores ni tamaños enseña solo el botón para añadir otra.
 *
 * El nombre, el precio y «a la venta» de cada versión que YA existe se editan
 * en su tarjeta, no aquí: este bloque solo añade, quita y ordena (ver
 * guardar-versiones.ts). La única excepción es la versión sin nombre de un
 * producto que pasa a tener dos: necesita uno, y se escribe aquí.
 *
 * TODO FUNCIONA SIN JAVASCRIPT: subir, bajar y añadir son botones `submit`
 * con `name="accion"` que re-pintan el bloque con lo escrito, sin guardar
 * (`aplicarAccion` en forma.ts). Quitar es una casilla que se aplica al
 * guardar. Con JS, esos mismos envíos van por `fetch` y solo se sustituye
 * este bloque (cliente-bloques.ts).
 */
import { ruta } from '../../datos/sitio';
import EstadoBloque from './EstadoBloque.astro';
import type { Borrador, Errores } from './forma';

interface Props {
  productoId: number;
  b: Borrador;
  errores: Errores;
  /** Por id: si tiene historia de inventario (no se puede quitar) y cuántas fotos. */
  info: Map<number, { fotos: number; conHistorial: boolean; guardado: string }>;
  hecho?: string;
  aviso?: string;
  conflicto?: string[] | null;
  sucio: boolean;
}

const { productoId, b, errores, info, hecho, aviso, conflicto, sucio } = Astro.props as Props;
const varias = b.filas.length > 1;
const e = (k: string) => errores[k];
const hayErrores = Object.keys(errores).length > 0;
---

<section
  class="pp-bloque pb-bloque"
  id="bloque-versiones"
  data-bloque="versiones"
  data-sucio={sucio ? '1' : undefined}
  aria-labelledby="t-versiones"
>
  <div class="pb-cabeza">
    <h2 class="p-seccion__titulo" id="t-versiones">Versiones</h2>
    <span class="pb-sin-guardar" data-sin-guardar hidden={!sucio}>Sin guardar</span>
  </div>
  <p class="pp-ayuda">
    {varias
      ? 'Añade, quita u ordena los colores o tamaños. El nombre y el precio de cada uno se cambian en su tarjeta.'
      : 'Este producto se vende en una sola versión. Si viene en varios colores o tamaños, añádelos aquí.'}
  </p>

  <form id="f-versiones" method="post" action={ruta(`/admin/productos/${productoId}`)} class="pp-forma" novalidate data-bloque-form>
    <button type="submit" name="accion" value="guardar" class="pp-oculto" tabindex="-1" aria-hidden="true">
      Guardar
    </button>
    <input type="hidden" name="bloque" value="versiones" />
    <input type="hidden" name="version" value={b.version} />
    <input type="hidden" name="filas" value={b.filas.length} />

    {
      (varias || b.opcionNombre) && (
        <div class="pp-campo">
          <label class="p-campo__etiqueta" for="f-opcion">¿Qué cambia entre las versiones?</label>
          <input
            id="f-opcion"
            name="opcion_nombre"
            type="text"
            value={b.opcionNombre}
            placeholder="Color, Tamaño, Capacidad…"
            aria-invalid={e('opcion_nombre') ? 'true' : undefined}
            aria-describedby={e('opcion_nombre') ? 'e-opcion_nombre' : undefined}
          />
          {e('opcion_nombre') && <p class="pp-error-campo" id="e-opcion_nombre">{e('opcion_nombre')}</p>}
        </div>
      )
    }

    <ol class="pp-filas" hidden={!varias}>
      {
        b.filas.map((f, i) => {
          const datos = f.id !== null ? info.get(f.id) : undefined;
          /* Editable: las nuevas, y la que existe sin nombre todavía. */
          const nombreEditable = !datos || !datos.guardado;
          const nombre = f.titulo || `Versión ${i + 1}`;
          return (
            <li class:list={['pp-fila', { 'pp-fila--quitar': f.quitar }]}>
              <input type="hidden" name={`v${i}_id`} value={f.id ?? ''} />
              <div class="pp-fila__cabeza">
                <span class="pp-fila__numero">
                  {`Versión ${i + 1}`}
                  {!nombreEditable && <b class="pb-fila-nombre">{` · ${f.titulo}`}</b>}
                  {!datos && <span class="f-etiqueta">Nueva</span>}
                </span>
                {/* Flechas como botones de verdad, con su nombre accesible. */}
                <span class="pp-fila__mover">
                  <button type="submit" name="accion" value={`subir:${i}`} class="pp-flecha" disabled={i === 0} aria-label={`Subir ${nombre}`}>
                    ↑
                  </button>
                  <button
                    type="submit"
                    name="accion"
                    value={`bajar:${i}`}
                    class="pp-flecha"
                    disabled={i === b.filas.length - 1}
                    aria-label={`Bajar ${nombre}`}
                  >
                    ↓
                  </button>
                </span>
              </div>

              {nombreEditable && (
                <div class="pp-fila__campos">
                  <div class="pp-campo pp-campo--nombre">
                    <label class="p-campo__etiqueta" for={`f-v${i}-titulo`}>Nombre</label>
                    <input
                      id={`f-v${i}-titulo`}
                      name={`v${i}_titulo`}
                      type="text"
                      value={f.titulo}
                      placeholder="Negro, 6 tazas…"
                      aria-invalid={e(`v${i}_titulo`) ? 'true' : undefined}
                      aria-describedby={e(`v${i}_titulo`) ? `e-v${i}_titulo` : undefined}
                    />
                    {e(`v${i}_titulo`) && <p class="pp-error-campo" id={`e-v${i}_titulo`}>{e(`v${i}_titulo`)}</p>}
                  </div>
                  {!datos && (
                    <div class="pp-campo pp-campo--precio">
                      <label class="p-campo__etiqueta" for={`f-v${i}-precio`}>Precio</label>
                      <span class="pp-precio">
                        <span aria-hidden="true">$</span>
                        <input
                          id={`f-v${i}-precio`}
                          name={`v${i}_precio`}
                          type="text"
                          inputmode="numeric"
                          value={f.precioTexto}
                          placeholder="315.000"
                          aria-invalid={e(`v${i}_precio`) ? 'true' : undefined}
                          aria-describedby={e(`v${i}_precio`) ? `e-v${i}_precio` : undefined}
                        />
                      </span>
                      {e(`v${i}_precio`) && <p class="pp-error-campo" id={`e-v${i}_precio`}>{e(`v${i}_precio`)}</p>}
                    </div>
                  )}
                </div>
              )}

              <div class="pp-fila__casillas">
                {!datos && (
                  <label class="pp-casilla">
                    <input type="checkbox" name={`v${i}_venta`} value="1" checked={f.aLaVenta} />
                    <span>
                      <b>A la venta</b>
                    </span>
                  </label>
                )}
                {datos?.conHistorial ? (
                  <p class="pp-nota-fila">
                    Ya tiene ventas o unidades registradas en el inventario, así que no se puede quitar. Si
                    ya no lo vendes, desmarca «A la venta» en su tarjeta.
                  </p>
                ) : (
                  <label class="pp-casilla pp-casilla--quitar">
                    <input type="checkbox" name={`v${i}_quitar`} value="1" checked={f.quitar} />
                    <span>
                      <b>{datos ? 'Quitar esta versión al guardar' : 'Descartar esta versión nueva'}</b>
                      {datos && datos.fotos > 0 && (
                        <small>
                          Sus {datos.fotos} {datos.fotos === 1 ? 'foto pasa' : 'fotos pasan'} a ser del producto
                          en general; no se borran.
                        </small>
                      )}
                    </span>
                  </label>
                )}
                {e(`v${i}_quitar`) && <p class="pp-error-campo">{e(`v${i}_quitar`)}</p>}
              </div>
            </li>
          );
        })
      }
    </ol>

    <button type="submit" name="accion" value="anadir" class="v-boton v-boton--linea pp-anadir">
      {varias ? 'Añadir otra versión' : 'Viene en varios colores o tamaños: añadir otra versión'}
    </button>
  </form>

  {
    (varias || sucio) && (
      <div class="pp-guardar pb-guardar">
        <button form="f-versiones" type="submit" name="accion" value="guardar" class="v-boton v-boton--oro">
          Guardar versiones
        </button>
      </div>
    )
  }
  <EstadoBloque
    hecho={hecho}
    aviso={aviso}
    conflicto={conflicto}
    error={errores.general ?? hayErrores}
    boton="Guardar versiones"
    productoId={productoId}
  />
</section>
