---
/**
 * BloqueVersion — la tarjeta de UNA versión («Verde»): nombre, precio, a la
 * venta y SUS fotos, con su botón «Guardar esta versión». Debajo, su
 * inventario.
 *
 * Con una sola versión (19 de los 25 productos del respaldo) la tarjeta se
 * llama «Precio y venta», el nombre es opcional y no tiene fotos propias: no
 * hay color que elegir y todas las fotos son del producto.
 *
 * EL INVENTARIO NO SE GUARDA CON EL BOTÓN DE LA TARJETA
 * ===========================================================================
 * Pedido del cliente (9 oct 2026): el inventario dentro de la ficha. Pero
 * «Vendí 1 por WhatsApp» no es un dato a medio escribir: es algo que YA pasó,
 * y se aplica al pulsar, con su propio deshacer (inventario-acciones.ts). Por
 * eso va en un sub-bloque aparte, con sus propios formularios, después del
 * botón de guardar: si fuera parte del formulario de la versión, «Guardar
 * esta versión» volvería a vender.
 *
 * Y «A la venta» vive SOLO aquí arriba, como casilla de la versión, con su
 * cerrojo. El inventario ya no tiene su propio «Retirar de la venta»: dos
 * interruptores de lo mismo en la misma tarjeta acabarían diciendo cosas
 * distintas. Lo que SÍ hace el inventario (encendido) es desmarcarla sola
 * cuando la versión se agota, y volver a marcarla si se agotó y llegan
 * unidades (migrations/0010); la nota de debajo de la casilla lo dice.
 */
import { ruta } from '../../datos/sitio';
import type { FilaInventario } from '../../datos/inventario';
import FilaVariante from '../inventario-fila.astro';
import FotosBloque from './FotosBloque.astro';
import SubirFotos from './SubirFotos.astro';
import EstadoBloque from './EstadoBloque.astro';
import type { BorradorVersion } from './guardar';
import type { Errores } from './forma';
import type { FotoVista } from './ficha';

interface Props {
  productoId: number;
  /** El nombre GUARDADO (el título de la tarjeta no cambia mientras escribe). */
  titulo: string;
  bv: BorradorVersion;
  /** La única versión del producto: «Precio y venta», sin fotos propias. */
  unica: boolean;
  /** No es la primera tarjeta: lleva su número para orientarse. */
  numero: number;
  fotos: FotoVista[];
  versiones: { id: number; titulo: string }[];
  roles: { id: string; nombre: string }[];
  errores: Errores;
  hecho?: string;
  conflicto?: string[] | null;
  desaparecida?: boolean;
  sucio: boolean;
  inventario?: FilaInventario;
  inventarioActivo: boolean;
  /** Retirada sola al agotarse (migrations/0010), no por ella. */
  agotadaAuto?: boolean;
  /** Días de entrega si el producto se puede pedir por encargo (migrations/0011). */
  diasEncargo?: number | null;
  paquete: number | null;
  abrirInventario: boolean;
}

const p = Astro.props as Props;
const { productoId, bv, unica, errores } = p;
const clave = `v${bv.id}`;
const idForm = `f-${clave}`;
const titulo = unica ? 'Precio y venta' : p.titulo || `Versión ${p.numero}`;
const hayErrores = Object.keys(errores).length > 0;
const pendientes = p.fotos.filter((f) => f.porRevisar).length;
const e = (k: string) => errores[k];

/* Por qué la casilla está como está, cuando no lo dice ella sola. Con lo
   GUARDADO (`agotadaAuto`, el físico), no con lo que lleva el formulario. */
const fisico = p.inventario?.fisico ?? null;
/* POR ENCARGO (migrations/0011): lo agotado no sale «Agotado» sino «Por
   encargo», salvo lo que ella retiró a mano. Las notas lo dicen. */
const encargo = p.inventarioActivo && p.diasEncargo ? `«Por encargo · entrega en ${p.diasEncargo} días»` : '';
let notaVenta = '';
if (p.inventarioActivo && !bv.aLaVenta && p.agotadaAuto) {
  notaVenta = encargo
    ? `Se desmarcó sola porque se agotó. Como el producto es por encargo, en la tienda sale ${encargo}. Vuelve sola a la venta cuando cargues unidades.`
    : 'Se desmarcó sola porque se agotó. Vuelve sola a la venta cuando cargues unidades.';
} else if (p.inventarioActivo && bv.aLaVenta && fisico !== null && fisico <= 0) {
  notaVenta = encargo
    ? `No te queda ninguna: en la tienda sale ${encargo} hasta que cargues unidades.`
    : 'No te queda ninguna: en la tienda sale «Agotado» hasta que cargues unidades.';
} else if (encargo && !bv.aLaVenta) {
  notaVenta = 'La retiraste tú: no se vende, ni por encargo.';
}
---

<section
  class="pp-bloque pb-bloque pb-version"
  id={`bloque-${clave}`}
  data-bloque={clave}
  data-nombre={p.titulo}
  data-sucio={p.sucio ? '1' : undefined}
  aria-labelledby={`t-${clave}`}
>
  <div class="pb-cabeza">
    <h2 class="p-seccion__titulo" id={`t-${clave}`}>
      {!unica && <span class="pb-numero">Versión {p.numero} ·</span>} {titulo}
    </h2>
    <span class="pb-sin-guardar" data-sin-guardar hidden={!p.sucio}>Sin guardar</span>
  </div>

  <form id={idForm} method="post" action={ruta(`/admin/productos/${productoId}`)} class="pp-forma" novalidate data-bloque-form>
    <button type="submit" name="accion" value="guardar" class="pp-oculto" tabindex="-1" aria-hidden="true">
      Guardar
    </button>
    <input type="hidden" name="bloque" value="variante" />
    <input type="hidden" name="v" value={bv.id} />
    <input type="hidden" name="version" value={bv.version} />

    <div class="pp-fila__campos">
      <div class="pp-campo pp-campo--nombre">
        <label class="p-campo__etiqueta" for={`${idForm}-titulo`}>
          {unica ? 'Nombre de la versión (opcional)' : 'Nombre'}
        </label>
        <input
          id={`${idForm}-titulo`}
          name="titulo"
          type="text"
          value={bv.titulo}
          placeholder="Negro, 6 tazas…"
          autocomplete="off"
          aria-invalid={e('titulo') ? 'true' : undefined}
          aria-describedby={e('titulo') ? `${idForm}-e-titulo` : undefined}
        />
        {e('titulo') && <p class="pp-error-campo" id={`${idForm}-e-titulo`}>{e('titulo')}</p>}
      </div>

      <div class="pp-campo pp-campo--precio">
        <label class="p-campo__etiqueta" for={`${idForm}-precio`}>Precio</label>
        <span class="pp-precio">
          <span aria-hidden="true">$</span>
          {/* `text` y no `number`: `number` no acepta «315.000» con el punto
              de miles que se escribe en Colombia, y en algunos teléfonos lo
              vacía en silencio. `inputmode` saca igual el teclado numérico. */}
          <input
            id={`${idForm}-precio`}
            name="precio"
            type="text"
            inputmode="numeric"
            value={bv.precioTexto}
            placeholder="315.000"
            aria-invalid={e('precio') ? 'true' : undefined}
            aria-describedby={e('precio') ? `${idForm}-e-precio` : undefined}
          />
        </span>
        {e('precio') && <p class="pp-error-campo" id={`${idForm}-e-precio`}>{e('precio')}</p>}
      </div>
    </div>

    {/* `venta_antes`: cómo estaba la casilla al pintarse. El inventario la
        desmarca solo al agotarse sin subir el cerrojo de la tarjeta, así que
        guardar solo la escribe si ella la cambió (guardar.ts, `tocaLaVenta`).
        Todo va envuelto para que cliente-inventario.ts lo pueda poner al día
        tras un «Vendí 1», si ella no la ha tocado. */}
    <div class="pb-venta" data-venta-casilla={bv.id}>
      <input type="hidden" name="venta_antes" value={(bv.aLaVentaAntes ?? bv.aLaVenta) ? '1' : '0'} />
      <label class="pp-casilla">
        <input type="checkbox" name="venta" value="1" checked={bv.aLaVenta} />
        <span>
          <b>A la venta</b>
          <small>Desmárcalo para que salga «Agotado» sin borrar nada.</small>
        </span>
      </label>
      {
        notaVenta && (
          <p class="pb-venta__nota" role="note">
            {notaVenta}
          </p>
        )
      }
    </div>

    {
      !unica && (
        <>
          <h3 class="pb-subtitulo">
            Fotos de {titulo} <span class="f-cuenta" data-f-cuenta>{p.fotos.length}</span>
          </h3>
          <FotosBloque
            fotos={p.fotos}
            grupo={clave}
            versiones={p.versiones}
            roles={p.roles}
            version={p.titulo}
            rutaFotos={ruta(`/admin/productos/${productoId}/fotos`)}
            errores={errores}
          />
        </>
      )
    }
  </form>

  {
    !unica && !p.desaparecida && (
      <SubirFotos
        accion={ruta(`/admin/productos/${productoId}/subir`)}
        destino={String(bv.id)}
        texto={`Agregar fotos de ${titulo}`}
        clave={clave}
      />
    )
  }

  {
    !p.desaparecida && (
      <div class="pp-guardar pb-guardar">
        <button form={idForm} type="submit" name="accion" value="guardar" class="v-boton v-boton--oro">
          {unica ? 'Guardar precio' : 'Guardar esta versión'}
        </button>
        <span class="pb-pendientes" data-f-pendientes hidden={!pendientes}>
          {pendientes === 1 ? '1 foto sin publicar' : `${pendientes} fotos sin publicar`}
        </span>
      </div>
    )
  }
  <EstadoBloque
    hecho={p.hecho}
    conflicto={p.conflicto}
    desaparecida={p.desaparecida}
    error={errores.general ?? hayErrores}
    boton={unica ? 'Guardar precio' : 'Guardar esta versión'}
    productoId={productoId}
  />

  {
    p.inventario && (
      <div class="pb-inventario" data-inv-bloque={bv.id}>
        <h3 class="pb-subtitulo">Inventario{!unica && ` de ${titulo}`}</h3>
        <p class="pp-ayuda">
          Estos botones se aplican al pulsar; no hace falta «Guardar».
          {!p.inventarioActivo && ' El inventario está apagado: la tienda todavía no usa estas cantidades.'}
          {p.diasEncargo && ' Por encargo: puedes registrar la venta aunque no haya unidades (quedará en negativo hasta que llegue).'}
        </p>
        <FilaVariante
          fila={p.inventario}
          paquete={p.paquete}
          abierto={p.abrirInventario}
          unica={true}
          volver={`p${productoId}`}
          como="div"
          activo={p.inventarioActivo}
        />
      </div>
    )
  }
</section>
