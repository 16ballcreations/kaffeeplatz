{
  "name": "kaffeeplatz",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/verificar-puerta.mjs",
    "preview": "astro build && wrangler dev --local",
    "astro": "astro",
    "normalizar": "node scripts/normalizar.mjs",
    "contraste": "node scripts/contraste.mjs",
    "probar:saneador": "node scripts/probar-saneador.mjs && node scripts/probar-saneador-markdown.mjs",
    "verificar:puerta": "node scripts/verificar-puerta.mjs",
    "hash-clave": "node scripts/hash-clave.mjs",
    "deploy": "astro build && wrangler deploy",
    "imagenes": "node scripts/optimizar-imagenes.mjs",
    "redirecciones": "node scripts/redirecciones.mjs",
    "imagen-social": "node scripts/imagen-social.mjs",
    "d1:migrar": "wrangler d1 migrations apply kaffeeplatz --local",
    "d1:sembrar": "node scripts/sembrar-d1.mjs && wrangler d1 execute kaffeeplatz --local --file tmp/semilla.sql",
    "d1:comparar": "node --no-warnings scripts/comparar-d1.mjs",
    "deploy:dev": "astro build && wrangler deploy --config wrangler.dev.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "5.18.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "vite": "$vite"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "wrangler": "^4.145.0"
  }
}