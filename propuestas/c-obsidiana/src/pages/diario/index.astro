---
/**
 * /diario — Indice del diario, con filtro por tema.
 *
 * Los recuentos salen SIEMPRE del dato (articulos.length, conteo por
 * categoria): anadir o retirar articulos no desactualiza ningun texto.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { ruta } from '../../datos/sitio';
import { CATEGORIAS_DIARIO } from '../../datos/categorias';
import FiltrosCategoria from '../../components/FiltrosCategoria.astro';

const articulos = (await getCollection('diario')).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);

/* Solo se ofrecen los temas que tienen articulos, con su recuento real. */
const conteo = new Map<string, number>();
for (const a of articulos) {
  conteo.set(a.data.categoria, (conteo.get(a.data.categoria) ?? 0) + 1);
}

const temasConArticulos = CATEGORIAS_DIARIO.filter((c) => (conteo.get(c.id) ?? 0) > 0).sort(
  (a, b) => a.orden - b.orden,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Diario KaffeePlatz',
  description: 'Guías y apuntes sobre café de especialidad y métodos de preparación.',
  blogPost: articulos.map((a) => ({
    '@type': 'BlogPosting',
    headline: a.data.titulo,
    datePublished: a.data.fecha.toISOString().slice(0, 10),
    author: { '@type': 'Person', name: a.data.autor },
    url: new URL(ruta(`/diario/${a.data.handle}`), Astro.site).toString(),
  })),
};
---

<Base
  titulo="Diario"
  descripcion="Guías prácticas de café de especialidad: métodos, molienda, conservación y errores comunes al preparar café en casa."
  camino="/diario"
  migas={[{ nombre: 'Diario', href: '/diario' }]}
  jsonLd={jsonLd}
>
  <header data-kp-seccion="encabezado" class="c-encabezado">
    <div class="c-encabezado__interior">
      <p data-kp-kicker>Lecturas</p>
      <h1>Diario</h1>
      <p data-kp-entradilla>
        Lo que hemos ido aprendiendo preparando café: cómo funciona cada método, qué molienda pide,
        cómo conservar el grano y en qué solemos equivocarnos. {articulos.length} artículos.
      </p>
    </div>
  </header>

  <section aria-label="Artículos">
    {/* Mismo componente que /catalogo: una sola implementacion de filtros. */}
    <FiltrosCategoria
      categorias={temasConArticulos}
      conteo={conteo}
      total={articulos.length}
      objetivo='[data-kp-rejilla="articulos"]'
      etiqueta="Filtrar artículos por tema"
      sustantivo="artículo"
      textoVacio="No hay artículos en este tema."
    />

    <ul data-kp-rejilla="articulos">
      {
        articulos.map((a, i) => (
          <li data-categoria={a.data.categoria}>
            <TarjetaArticulo articulo={a.data} prioridad={i < 3} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
