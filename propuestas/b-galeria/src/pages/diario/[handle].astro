---
/**
 * /diario/[handle] — Artículo del diario. 16 páginas. PROPUESTA B "GALERÍA".
 *
 * Aquí el lenguaje da lo mejor sin pedir fotografía: titular grande y ligero
 * sobre crema, medida corta (68ch), y la columna de prosa como protagonista.
 * La portada, cuando existe, va enmarcada; nunca hay texto sobre la foto.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/Imagen.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import BotonWhatsApp from '../../components/BotonWhatsApp.astro';
import { SITIO, ruta } from '../../datos/sitio';

export const getStaticPaths: GetStaticPaths = async () => {
  const articulos = await getCollection('diario');
  return articulos.map((a) => ({
    params: { handle: a.data.handle },
    props: { articulo: a, todos: articulos },
  }));
};

interface Props {
  articulo: CollectionEntry<'diario'>;
  todos: CollectionEntry<'diario'>[];
}

const { articulo, todos } = Astro.props as Props;
const d = articulo.data;
const { Content } = await render(articulo);

const iso = d.fecha.toISOString().slice(0, 10);
const fechaLegible = d.fecha.toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const otros = todos
  .filter((a) => a.data.handle !== d.handle)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titulo,
  description: d.resumen,
  datePublished: iso,
  dateModified: iso,
  inLanguage: 'es-CO',
  author: { '@type': 'Person', name: d.autor },
  publisher: {
    '@type': 'Organization',
    name: SITIO.nombre,
    url: new URL(ruta('/'), Astro.site).toString(),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(ruta(`/diario/${d.handle}`), Astro.site).toString(),
  },
  ...(d.imagen ? { image: new URL(ruta(d.imagen), Astro.site).toString() } : {}),
};
---

<Base
  titulo={d.titulo}
  descripcion={d.resumen.slice(0, 160)}
  camino={`/diario/${d.handle}`}
  imagen={d.imagen}
  tipoOg="article"
  migas={[
    { nombre: 'Diario', href: '/diario' },
    { nombre: d.titulo, href: `/diario/${d.handle}` },
  ]}
  jsonLd={jsonLd}
>
  <article data-kp-articulo-completo>
    <header data-kp-articulo-encabezado class="g-seccion g-agua">
      <div class="g-envoltura">
        <div class="g-articulo-encabezado">
          <p data-kp-kicker class="g-kicker">
            <a href={ruta('/diario')} class="g-migas-enlace">Diario</a>
          </p>
          <h1 class="g-display-min">{d.titulo}</h1>
          <p data-kp-articulo-meta class="g-kicker-tenue">
            <time datetime={iso}>{fechaLegible}</time> · {d.autor}
          </p>
          {d.resumen && <p data-kp-entradilla class="g-entradilla">{d.resumen}</p>}
        </div>
      </div>
    </header>

    {
      d.imagen && (
        <figure data-kp-articulo-portada class="g-articulo-portada">
          <div class="g-envoltura">
            <div class="g-marco g-marco-ancho">
              <Imagen src={d.imagen} alt={`Portada de: ${d.titulo}`} prioridad />
            </div>
          </div>
        </figure>
      )
    }

    <div class="g-envoltura g-seccion-ajustada">
      <div data-kp-prosa>
        <Content />
      </div>

      <aside data-kp-articulo-cierre class="g-panel g-articulo-cierre">
        <p class="g-h3">¿Te quedó alguna duda sobre el método o el equipo?</p>
        <p class="g-nota">Escríbenos y lo vemos contigo.</p>
        <div class="g-fila">
          <BotonWhatsApp
            mensaje={`Hola KaffeePlatz, leí "${d.titulo}" y tengo una duda.`}
            clase="g-pildora g-pildora-oro"
          >
            Preguntar por WhatsApp
          </BotonWhatsApp>
          <a href={ruta('/catalogo')} class="g-pildora g-pildora-linea">Ver el catálogo</a>
        </div>
      </aside>
    </div>
  </article>

  {
    otros.length > 0 && (
      <section data-kp-seccion="mas-diario" aria-labelledby="t-mas" class="g-seccion g-linea-sup">
        <div class="g-envoltura">
          <div class="g-cabecera-seccion">
            <div class="g-pila-ajustada">
              <p class="g-kicker">Más del diario</p>
              <h2 id="t-mas" class="g-h2">
                sigue <span class="g-cursiva">leyendo</span>
              </h2>
            </div>
          </div>
          <ul data-kp-rejilla="articulos">
            {otros.map((a) => (
              <li>
                <TarjetaArticulo articulo={a.data} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>
