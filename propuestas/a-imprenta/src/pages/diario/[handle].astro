---
/**
 * /diario/[handle] — Articulo del diario, lenguaje IMPRENTA. 16 paginas.
 *
 * Cabecera editorial a toda la medida, portada enmarcada (nunca a sangre) y
 * prosa a medida de lectura. El JSON-LD es identico al de la base.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Imprenta from '../../layouts/Imprenta.astro';
import Imagen from '../../components/Imagen.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import BotonWhatsApp from '../../components/BotonWhatsApp.astro';
import { SITIO, ruta } from '../../datos/sitio';

export const getStaticPaths: GetStaticPaths = async () => {
  const articulos = await getCollection('diario');
  return articulos.map((a) => ({
    params: { handle: a.data.handle },
    props: { articulo: a, todos: articulos },
  }));
};

interface Props {
  articulo: CollectionEntry<'diario'>;
  todos: CollectionEntry<'diario'>[];
}

const { articulo, todos } = Astro.props as Props;
const d = articulo.data;
const { Content } = await render(articulo);

const iso = d.fecha.toISOString().slice(0, 10);
const fechaLegible = d.fecha.toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const otros = todos
  .filter((a) => a.data.handle !== d.handle)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titulo,
  description: d.resumen,
  datePublished: iso,
  dateModified: iso,
  inLanguage: 'es-CO',
  author: { '@type': 'Person', name: d.autor },
  publisher: {
    '@type': 'Organization',
    name: SITIO.nombre,
    url: new URL(ruta('/'), Astro.site).toString(),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(ruta(`/diario/${d.handle}`), Astro.site).toString(),
  },
  ...(d.imagen ? { image: new URL(ruta(d.imagen), Astro.site).toString() } : {}),
};
---

<Imprenta
  titulo={d.titulo}
  descripcion={d.resumen.slice(0, 160)}
  camino={`/diario/${d.handle}`}
  imagen={d.imagen}
  tipoOg="article"
  migas={[
    { nombre: 'Diario', href: '/diario' },
    { nombre: d.titulo, href: `/diario/${d.handle}` },
  ]}
  jsonLd={jsonLd}
>
  <article data-kp-articulo-completo>
    {/* ---------- Cabecera editorial ---------- */}
    <header data-kp-articulo-encabezado class="im-contenedor im-seccion--amplia">
      <div class="im-rubrica">
        <span data-kp-kicker class="im-rubrica__label">Diario</span>
        <hr class="im-rubrica__regla" />
        <span class="im-rubrica__enlace" style="color:var(--kp-ink-muted)">{fechaLegible}</span>
      </div>

      <h1 class="im-display" style="font-size:var(--im-display-xl);max-width:20ch">
        {d.titulo}
      </h1>

      <p data-kp-articulo-meta class="im-nota" style="margin-top:var(--im-20)">
        <time datetime={iso}>{fechaLegible}</time> · {d.autor}
      </p>

      {d.resumen && <p data-kp-entradilla class="im-entradilla" style="margin-top:var(--im-20)">{d.resumen}</p>}
    </header>

    {/* ---------- Portada SIEMPRE enmarcada, nunca a sangre ---------- */}
    {
      d.imagen && (
        <figure
          data-kp-articulo-portada
          class="im-contenedor"
          style="margin:0 auto var(--im-50)"
        >
          {/* Marco "intacto": la portada conserva su proporcion. Varias fotos
              del diario llevan texto incrustado y un recorte 3:2 lo cortaria. */}
          <div class="im-marco im-marco--intacto">
            <Imagen src={d.imagen} alt={`Portada de: ${d.titulo}`} prioridad />
          </div>
        </figure>
      )
    }

    {/* ---------- Prosa ---------- */}
    <div class="im-contenedor">
      <div data-kp-prosa class="im-prosa">
        <Content />
      </div>
    </div>

    {/* ---------- Cierre ---------- */}
    <aside data-kp-articulo-cierre class="im-contenedor" style="margin-top:var(--im-50)">
      <div class="im-panel im-medida im-pila-20">
        <p class="im-label">¿Dudas?</p>
        <p style="font-family:var(--im-display);font-weight:300;font-size:var(--im-display-s);line-height:1.3">
          ¿Te quedó alguna duda sobre el método o el equipo? Escríbenos y lo vemos contigo.
        </p>
        <div class="im-acciones">
          <BotonWhatsApp
            mensaje={`Hola KaffeePlatz, leí "${d.titulo}" y tengo una duda.`}
            clase="im-accion"
          >
            Preguntar por WhatsApp
          </BotonWhatsApp>
          <a href={ruta('/catalogo')} class="im-flecha">Ver el catálogo</a>
        </div>
      </div>
    </aside>
  </article>

  {
    otros.length > 0 && (
      <>
        <hr class="im-filete" style="margin-top:var(--im-50)" />
        <section data-kp-seccion="mas-diario" aria-labelledby="t-mas" class="im-contenedor im-seccion--amplia">
          <div class="im-rubrica">
            <span class="im-rubrica__label">Sigue leyendo</span>
            <hr class="im-rubrica__regla" />
            <a href={ruta('/diario')} class="im-rubrica__enlace im-flecha">
              Todo el diario
            </a>
          </div>

          <h2 id="t-mas" class="im-titulo-seccion im-medida" style="margin-bottom:var(--im-30)">
            Sigue leyendo
          </h2>

          <ul data-kp-rejilla="articulos">
            {otros.map((a) => (
              <li>
                <TarjetaArticulo articulo={a.data} />
              </li>
            ))}
          </ul>
        </section>
      </>
    )
  }
</Imprenta>
